{%- comment -%} Veloura — Before/After section (PRD §1.2 / §2.4) {%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout
-%}
<section class="v-ba-section {% if section.settings.blush %}v-section--blush{% endif %}">
  <div class="v-container">
    {%- if layout == 'split' -%}
      <div class="v-ba-section__split">
        <div class="v-ba-section__copy v-reveal">
          {%- if section.settings.eyebrow != blank -%}<span class="v-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="v-h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.body != blank -%}<p class="v-muted v-body" style="margin-top:18px;max-width:42ch;">{{ section.settings.body }}</p>{%- endif -%}
          {%- if section.settings.quote != blank -%}
            <div class="v-ba-section__quote">
              <span class="v-stars">{% for i in (1..5) %}{% render 'veloura-icon', name: 'star', size: 15 %}{% endfor %}</span>
              <p class="v-italic">“{{ section.settings.quote }}”</p>
              <div class="v-ba-section__author">
                <span class="v-ba-section__avatar">
                  {%- if section.settings.author_image != blank -%}
                    <img src="{{ section.settings.author_image | image_url: width: 120 }}" alt="{{ section.settings.author_name | default: 'Reviewer' | escape }}" width="52" height="52" loading="lazy">
                  {%- else -%}
                    <img src="{{ 'veloura-review-avatar.png' | asset_url }}" alt="{{ section.settings.author_name | default: 'Reviewer' | escape }}" width="52" height="52" loading="lazy">
                  {%- endif -%}
                </span>
                <span class="v-ba-section__author-meta">
                  {%- if section.settings.author_name != blank -%}
                    <strong class="v-ba-section__name">{{ section.settings.author_name }}{%- if section.settings.author_age != blank -%}<span class="v-ba-section__age">, {{ section.settings.author_age }}</span>{%- endif -%}</strong>
                  {%- endif -%}
                  {%- if section.settings.quote_attr != blank -%}<span class="v-body-sm v-muted">{{ section.settings.quote_attr }}</span>{%- endif -%}
                </span>
              </div>
            </div>
          {%- endif -%}
        </div>
        <div class="v-ba-section__media v-reveal" data-delay="1">
          {% render 'veloura-before-after', before_img: section.settings.before_image, after_img: section.settings.after_image, ratio: '2 / 3' %}
        </div>
      </div>
    {%- else -%}
      <div class="v-card v-ba-section__card v-reveal">
        <div class="v-section-head" style="margin-bottom:32px;">
          {%- if section.settings.eyebrow != blank -%}<span class="v-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="v-h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.body != blank -%}<p class="v-muted v-body">{{ section.settings.body }}</p>{%- endif -%}
        </div>
        {% render 'veloura-before-after', before_img: section.settings.before_image, after_img: section.settings.after_image, ratio: '2 / 3' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.v-ba-section { padding-block: clamp(48px, 8vw, 80px); }
.v-ba-section .v-h2 { font-weight: 700; }
.v-ba-section__card { max-width: 820px; margin-inline: auto; padding: clamp(24px, 4vw, 48px); }
.v-ba-section__card .v-ba { max-width: 400px; margin-inline: auto; }
.v-ba-section__split { display: grid; grid-template-columns: 45% 55%; gap: clamp(32px, 5vw, 64px); align-items: center; }
.v-ba-section__copy .v-h2 { margin-bottom: 0; }
.v-ba-section__quote { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--v-border); display: grid; gap: 12px; }
.v-ba-section__quote .v-italic { font-size: 1.375rem; line-height: 1.4; }
.v-ba-section__author { display: flex; align-items: center; gap: 12px; margin-top: 2px; }
.v-ba-section__avatar { flex: none; width: 52px; height: 52px; border-radius: 50%; overflow: hidden; border: 2px solid var(--v-white); box-shadow: var(--v-shadow-card); }
.v-ba-section__avatar img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block; }
.v-ba-section__author-meta { display: flex; flex-direction: column; gap: 2px; }
.v-ba-section__name { font-family: var(--v-font-body); font-weight: 700; font-size: 1.0625rem; color: var(--v-text); }
/* Age rides on the name line in a lighter weight, so the name still leads and
   the two-line author block keeps its height. */
.v-ba-section__age { font-weight: 500; color: var(--v-muted); }
.v-ba-section__media { max-width: 460px; width: 100%; justify-self: center; }
@media (max-width: 849px) {
  .v-ba-section__split { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Before / After",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "card", "label": "Centered card" },
      { "value": "split", "label": "Split (copy + slider)" }
    ], "default": "card" },
    { "type": "checkbox", "id": "blush", "label": "Blush background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the structural change" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Visible reduction in dimpling after 30 days of consistent Velo-Lymph™ therapy." },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "header", "content": "Split layout extras" },
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "text", "id": "author_name", "label": "Reviewer name", "default": "Jessica M." },
    { "type": "text", "id": "author_age", "label": "Reviewer age (shown after the name)", "default": "38 years old" },
    { "type": "image_picker", "id": "author_image", "label": "Reviewer photo (round). Leave empty to use the built-in photo." },
    { "type": "text", "id": "quote_attr", "label": "Quote attribution", "default": "Verified Purchase" }
  ],
  "presets": [{ "name": "Veloura Before / After" }]
}
{% endschema %}
