{%- comment -%}
  Veloura — Product buy box (PRD §2.0–2.1).
  Sticky image gallery + buy box with bundle selector.
  Add-to-cart uses Dawn's <product-form> so the cart drawer works.
{%- endcomment -%}
{%- comment -%} Dawn's product-form custom element powers AJAX add-to-cart + drawer open {%- endcomment -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
-%}
<section class="v-pdp" data-section-id="{{ section.id }}">
  <div class="v-container">
    <div class="v-pdp__grid">

      {%- comment -%} ---- Left: sticky gallery ---- {%- endcomment -%}
      <div class="v-pdp__gallery" data-gallery>
        <div class="v-pdp__main">
          {%- if product.images.size > 0 -%}
            <img data-gallery-main src="{{ product.featured_image | image_url: width: 1100 }}" alt="{{ product.featured_image.alt | escape }}" width="1100" height="1375" fetchpriority="high">
          {%- else -%}
            <div class="v-pdp__ph v-placeholder" data-label="Veloura Legging — Front"></div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="v-pdp__thumbs">
            {%- for image in product.images limit: 5 -%}
              <button type="button" class="v-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-gallery-thumb
                      data-src="{{ image | image_url: width: 1100 }}" data-alt="{{ image.alt | escape }}">
                <img src="{{ image | image_url: width: 160 }}" alt="" width="80" height="100" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---- Right: buy box ---- {%- endcomment -%}
      <div class="v-pdp__buybox">
        {%- if s.overline != blank -%}<span class="v-eyebrow">{{ s.overline }}</span>{%- endif -%}
        <h1 class="v-h2 v-pdp__name">{{ product.title | default: 'Veloura Cellulite Legging' }}</h1>
        {%- if s.rating_text != blank -%}
          <div class="v-pdp__rating">
            <span class="v-stars">{% for i in (1..5) %}{% render 'veloura-icon', name: 'star', size: 16 %}{% endfor %}</span>
            <span class="v-pdp__rating-text">{{ s.rating_text }}</span>
          </div>
        {%- endif -%}
        {%- if s.hero_claim != blank -%}<p class="v-pdp__claim v-serif">{{ s.hero_claim }}</p>{%- endif -%}

        {%- unless product.has_only_default_variant -%}
          <div class="v-pdp__variants" data-pdp-variants-ui>
            {%- for option in product.options_with_values -%}
              <label class="v-pdp__option">
                <span class="v-pdp__option-name">{{ option.name }}</span>
                <select class="v-select" data-pdp-option="{{ forloop.index0 }}" aria-label="{{ option.name | escape }}">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </label>
            {%- endfor -%}
          </div>
          <script type="application/json" data-pdp-variants>{{ product.variants | json }}</script>
        {%- endunless -%}

        <div class="v-pdp__atc" data-atc-anchor>
          {%- if product != blank -%}
            <product-form class="product-form" data-section-id="{{ section.id }}">
              {%- form 'product', product, id: product_form_id, class: 'v-pdp__form', data-atc-form: 'true', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <input type="hidden" name="quantity" value="1" min="1">
                <button type="submit" name="add" class="v-btn v-btn--green v-btn--full v-btn--lg" {% unless current_variant.available %}disabled{% endunless %}>
                  {% render 'veloura-icon', name: 'bag', size: 18 %}
                  <span>{% if current_variant.available %}{{ s.atc_label | default: 'Add to Cart' }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                  <span class="loading__spinner hidden" aria-hidden="true">
                    <svg focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
                  </span>
                </button>
              {%- endform -%}
            </product-form>
          {%- else -%}
            <button type="button" class="v-btn v-btn--green v-btn--full v-btn--lg">{% render 'veloura-icon', name: 'bag', size: 18 %} {{ s.atc_label | default: 'Add to Cart' }}</button>
          {%- endif -%}

          {%- if s.scarcity != blank -%}
            <p class="v-pdp__scarcity"><span class="v-pdp__dot"></span>{{ s.scarcity }}</p>
          {%- endif -%}
          {%- if s.guarantee != blank -%}
            <p class="v-pdp__guarantee v-guarantee">{% render 'veloura-icon', name: 'check', size: 16 %}{{ s.guarantee }}</p>
          {%- endif -%}
        </div>

        {%- if s.body != blank -%}<p class="v-pdp__body v-muted" style="margin-top:28px;">{{ s.body }}</p>{%- endif -%}
        {%- if s.bullet_1 != blank or s.bullet_2 != blank -%}
          <ul class="v-pdp__bullets">
            {%- if s.bullet_1 != blank -%}<li>{% render 'veloura-icon', name: 'check', size: 16 %}{{ s.bullet_1 }}</li>{%- endif -%}
            {%- if s.bullet_2 != blank -%}<li>{% render 'veloura-icon', name: 'check', size: 16 %}{{ s.bullet_2 }}</li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.v-pdp { padding-block: 32px clamp(48px, 6vw, 72px); }
.v-pdp__grid { display: grid; grid-template-columns: 55% 45%; gap: 48px; align-items: start; }
.v-pdp__gallery { position: sticky; top: calc(var(--header-height, 64px) + 24px); }
.v-pdp__main { border-radius: var(--v-radius-md); overflow: hidden; aspect-ratio: 4 / 5; background: #cdb6a8; }
.v-pdp__main img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.15s ease; }
.v-pdp__ph { width: 100%; height: 100%; }
.v-pdp__thumbs { display: flex; gap: 10px; margin-top: 12px; }
.v-pdp__thumb { width: 80px; height: 100px; border-radius: var(--v-radius-sm); overflow: hidden; border: 2px solid transparent; padding: 0; cursor: pointer; }
.v-pdp__thumb.is-active { border-color: var(--v-text); }
.v-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; }
.v-pdp__buybox { padding-top: 8px; }
.v-pdp .v-pdp__name { font-size: clamp(2.25rem, 4.8vw, 3.15rem); margin: 0 0 10px; }
.v-pdp__rating { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; }
.v-pdp__rating .v-stars { font-size: 1rem; }
.v-pdp__rating-text { font-size: 0.9375rem; font-weight: 500; color: var(--v-muted); }
.v-pdp__claim { font-size: 1.75rem; line-height: 1.25; margin: 0 0 16px; }
.v-pdp__body { font-size: 1.0625rem; line-height: 1.7; margin: 0 0 20px; }
.v-pdp__bullets { display: grid; gap: 10px; margin-bottom: 8px; }
.v-pdp__bullets li { display: flex; align-items: center; gap: 10px; font-size: 1.0625rem; }
.v-pdp__bullets svg { color: var(--v-green); flex: none; }
.v-pdp__variants { display: flex; flex-wrap: wrap; gap: 16px; margin: 22px 0 4px; }
.v-pdp__option { display: grid; gap: 6px; flex: 1 1 160px; }
.v-pdp__option-name { font-family: var(--v-font-body); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--v-text); }
.v-pdp__atc { margin-top: 22px; }
.v-pdp__scarcity { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 14px 0 0; font-size: 0.9375rem; font-weight: 600; color: var(--v-scarcity); }
.v-pdp__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--v-scarcity); display: inline-block; animation: v-pulse 1.6s ease-in-out infinite; }
.v-pdp__guarantee { justify-content: center; margin: 10px 0 0; }
@keyframes v-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
.v-pdp__form { margin: 0; }
@media (max-width: 989px) {
  .v-pdp__grid { grid-template-columns: 1fr; gap: 28px; }
  .v-pdp__gallery { position: static; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Product",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "text", "id": "overline", "label": "Overline", "default": "Velo-Lymph™ Enhanced" },
    { "type": "text", "id": "rating_text", "label": "Rating text (next to stars)", "default": "4.8 based on 471 Reviews" },
    { "type": "text", "id": "hero_claim", "label": "Hero claim", "default": "Reclaim your confidence. <strong>Smooth, sculpted legs in 8 weeks.</strong>" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Experience the freedom of wearing what you love. Our Velo-Lymph™ technology works with your body's natural rhythms to <strong>transform your skin while you live your life</strong>." },
    { "type": "text", "id": "bullet_1", "label": "Bullet 1", "default": "<strong>Not shapewear. Not compression.</strong>" },
    { "type": "text", "id": "bullet_2", "label": "Bullet 2", "default": "<strong>Works while you live.</strong> Zero effort." },
    { "type": "text", "id": "offer_banner", "label": "Offer banner (red)", "default": "Limited offer — Buy 1 Get 1 Free + Free Shipping" },
    { "type": "text", "id": "bundle_label", "label": "Bundle label", "default": "Bundle & Save" },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "text", "id": "scarcity", "label": "Scarcity text", "default": "Only 34 left in stock now" },
    { "type": "text", "id": "guarantee", "label": "Guarantee text (green)", "default": "60-day money-back guarantee — feel the difference or your money back" },
    { "type": "header", "content": "Variant options" },
    { "type": "text", "id": "colors", "label": "Colours (comma separated)", "default": "Slate,Black,Espresso" },
    { "type": "text", "id": "sizes", "label": "Sizes (comma separated)", "default": "XS,S,M,L,XL" },
    { "type": "header", "content": "Tier 1" },
    { "type": "text", "id": "t1_label", "label": "Label", "default": "1 Legging" },
    { "type": "text", "id": "t1_sub", "label": "Sub-copy", "default": "Starter Protocol" },
    { "type": "text", "id": "t1_price", "label": "Price", "default": "£44.99" },
    { "type": "text", "id": "t1_qty", "label": "Quantity", "default": "1" },
    { "type": "header", "content": "Tier 2 (default)" },
    { "type": "text", "id": "t2_badge", "label": "Badge", "default": "Most Popular" },
    { "type": "text", "id": "t2_label", "label": "Label", "default": "2 Leggings (Buy 1 Get 1 Free)" },
    { "type": "text", "id": "t2_price", "label": "Price", "default": "£44.99" },
    { "type": "text", "id": "t2_qty", "label": "Quantity", "default": "2" },
    { "type": "text", "id": "t2_save", "label": "Save badge", "default": "Save £44 + Free Shipping" },
    { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Full cellular update" },
    { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Consistent daily therapy" },
    { "type": "text", "id": "feature_3", "label": "Feature 3", "default": "Never miss a day. Maximum clinical results." },
    { "type": "header", "content": "Tier 3" },
    { "type": "text", "id": "t3_badge", "label": "Badge", "default": "Best Value" },
    { "type": "text", "id": "t3_label", "label": "Label", "default": "3 Leggings (Best Value)" },
    { "type": "text", "id": "t3_sub", "label": "Sub-copy", "default": "Maximum clinical results" },
    { "type": "text", "id": "t3_price", "label": "Price", "default": "£64.99" },
    { "type": "text", "id": "t3_qty", "label": "Quantity", "default": "3" },
    { "type": "text", "id": "t3_save", "label": "Save badge", "default": "Save £69.98 + Free Shipping" }
  ],
  "presets": [{ "name": "Veloura Product" }]
}
{% endschema %}
