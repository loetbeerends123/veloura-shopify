{%- comment -%}
  Veloura — Product buy box (PRD §2.0–2.1).
  Sticky image gallery + buy box. Bundle pricing/selection is handled by the
  Kaching Bundles app widget (app embed); the theme renders the offer banner.
  Add-to-cart uses Dawn's <product-form> so the cart drawer works.
{%- endcomment -%}
{%- comment -%} Dawn's product-form custom element powers AJAX add-to-cart + drawer open {%- endcomment -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
-%}
<section class="v-pdp" data-section-id="{{ section.id }}">
  {%- if s.community_text != blank -%}
    <div class="v-pdp-community">
      {% render 'veloura-icon', name: 'heart', size: 16 %}
      <p>{{ s.community_text }}</p>
    </div>
  {%- endif -%}
  <div class="v-container">
    <div class="v-pdp__grid">

      {%- comment -%} ---- Left: sticky gallery ---- {%- endcomment -%}
      <div class="v-pdp__gallery" data-gallery>
        <div class="v-pdp__main">
          {%- if product.images.size > 0 -%}
            <img data-gallery-main src="{{ product.featured_image | image_url: width: 1100 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1100" height="1375" fetchpriority="high">
          {%- else -%}
            <div class="v-pdp__ph v-placeholder" data-label="Veloura Legging — Front"></div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="v-pdp__thumbs">
            {%- for image in product.images limit: 5 -%}
              <button type="button" class="v-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-gallery-thumb
                      data-src="{{ image | image_url: width: 1100 }}" data-alt="{{ image.alt | escape }}">
                <img src="{{ image | image_url: width: 160 }}" alt="" width="80" height="100" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- comment -%}
          Colour → main-image map. The Kaching bundle app owns colour/size
          selection; this lets the left gallery swap to the chosen colour's
          photo when the shopper picks it in the bundle (see initColorImageSync).
        {%- endcomment -%}
        {%- liquid
          assign color_index = -1
          for opt in product.options_with_values
            assign onm = opt.name | downcase
            if onm == 'color' or onm == 'colour' or onm == 'kleur'
              assign color_index = forloop.index0
            endif
          endfor
        -%}
        {%- if color_index >= 0 -%}
          <script type="application/json" data-pdp-color-images>
          [
            {%- for v in product.variants -%}
              {"color": {{ v.options[color_index] | json }}, "src": {% if v.featured_image %}{{ v.featured_image | image_url: width: 1100 | json }}{% else %}null{% endif %}, "alt": {% if v.featured_image %}{{ v.featured_image.alt | default: product.title | json }}{% else %}{{ product.title | json }}{% endif %}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
          </script>
        {%- endif -%}
      </div>

      {%- comment -%} ---- Right: buy box ---- {%- endcomment -%}
      <div class="v-pdp__buybox" id="v-buybox">
        {%- if s.offer_banner != blank -%}
          <p class="v-pdp__offer">{% render 'veloura-icon', name: 'sparkle', size: 16 %}{{ s.offer_banner }}</p>
        {%- endif -%}
        {%- if s.overline != blank -%}<span class="v-eyebrow">{{ s.overline }}</span>{%- endif -%}
        <div class="v-pdp__titlerow">
          <h1 class="v-h2 v-pdp__name">{{ product.title | default: 'Veloura Cellulite Legging' }}</h1>
          <button type="button" class="v-pdp__sizeguide" data-sizeguide-open>
            {% render 'veloura-icon', name: 'arrows', size: 16 %} Size Chart
          </button>
        </div>
        {%- if s.rating_text != blank -%}
          <div class="v-pdp__rating">
            <span class="v-stars">{% for i in (1..4) %}{% render 'veloura-icon', name: 'star', size: 16 %}{% endfor %}{% render 'veloura-icon', name: 'star-half', size: 16 %}</span>
            <span class="v-pdp__rating-text">{{ s.rating_text }}</span>
          </div>
        {%- endif -%}
        {%- if s.hero_claim != blank -%}<p class="v-pdp__claim v-serif">{{ s.hero_claim }}</p>{%- endif -%}

        <dialog class="v-sizeguide" data-sizeguide aria-label="Size chart">
          <div class="v-sizeguide__panel">
            <button type="button" class="v-sizeguide__close" data-sizeguide-close aria-label="Close">{% render 'veloura-icon', name: 'close', size: 18 %}</button>
            <span class="v-eyebrow">Find Your Fit</span>
            <h3 class="v-h3 v-sizeguide__title">Size Chart</h3>
            <p class="v-sizeguide__note">Measurements in inches. The fabric has 4-way stretch — if you're between sizes, we recommend sizing up for all-day comfort.</p>
            <div class="v-sizeguide__scroll">
              <table class="v-sizeguide__table">
                <thead>
                  <tr><th>Size</th><th>Waist</th><th>Hip</th><th>Length</th></tr>
                </thead>
                <tbody>
                  <tr><td>S</td><td>22.8</td><td>26.7</td><td>31.4</td></tr>
                  <tr><td>M</td><td>24.4</td><td>28.7</td><td>32.3</td></tr>
                  <tr><td>L</td><td>25.9</td><td>30.7</td><td>33.1</td></tr>
                  <tr><td>XL</td><td>27.5</td><td>32.6</td><td>33.8</td></tr>
                  <tr><td>2XL</td><td>29.1</td><td>34.2</td><td>34.6</td></tr>
                  <tr><td>3XL</td><td>30.7</td><td>36.9</td><td>35.4</td></tr>
                  <tr><td>4XL</td><td>32.3</td><td>38.9</td><td>36.2</td></tr>
                  <tr><td>5XL</td><td>33.8</td><td>40.9</td><td>37.1</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </dialog>

        <div class="v-pdp__atc" data-atc-anchor>
          {%- if product != blank -%}
            <product-form class="product-form" data-section-id="{{ section.id }}">
              {%- form 'product', product, id: product_form_id, class: 'v-pdp__form', data-atc-form: 'true', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <input type="hidden" name="quantity" value="1" min="1">
                <button type="submit" name="add" class="v-btn v-btn--green v-btn--full v-btn--lg" {% unless current_variant.available %}disabled{% endunless %}>
                  {% render 'veloura-icon', name: 'bag', size: 20 %}
                  <span>{% if current_variant.available %}{{ s.atc_label | default: 'Add to Cart' }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                  <span class="loading__spinner hidden" aria-hidden="true">
                    <svg focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
                  </span>
                </button>
              {%- endform -%}
            </product-form>
          {%- else -%}
            <button type="button" class="v-btn v-btn--green v-btn--full v-btn--lg">{% render 'veloura-icon', name: 'bag', size: 20 %} {{ s.atc_label | default: 'Add to Cart' }}</button>
          {%- endif -%}

          {%- if s.scarcity != blank -%}
            <p class="v-pdp__scarcity"><span class="v-pdp__dot"></span>{{ s.scarcity }}</p>
          {%- endif -%}
          {% render 'veloura-trust-badges' %}
        </div>

        {%- if s.tagline != blank -%}<p class="v-pdp__tagline v-serif v-italic">{{ s.tagline }}</p>{%- endif -%}
        {%- if s.body != blank -%}<p class="v-pdp__body v-muted">{{ s.body }}</p>{%- endif -%}
        {%- if s.bullet_1 != blank or s.bullet_2 != blank or s.bullet_3 != blank -%}
          <ul class="v-pdp__benefits">
            {%- if s.bullet_1 != blank -%}{%- assign b1 = s.bullet_1 | split: ' — ' -%}<li>{% render 'veloura-icon', name: 'sparkle', size: 19 %}<span><strong>{{ b1[0] }}</strong>{%- if b1.size > 1 %} — {{ b1[1] }}{% endif -%}</span></li>{%- endif -%}
            {%- if s.bullet_2 != blank -%}{%- assign b2 = s.bullet_2 | split: ' — ' -%}<li>{% render 'veloura-icon', name: 'pulse', size: 19 %}<span><strong>{{ b2[0] }}</strong>{%- if b2.size > 1 %} — {{ b2[1] }}{% endif -%}</span></li>{%- endif -%}
            {%- if s.bullet_3 != blank -%}{%- assign b3 = s.bullet_3 | split: ' — ' -%}<li>{% render 'veloura-icon', name: 'calendar-clock', size: 19 %}<span><strong>{{ b3[0] }}</strong>{%- if b3.size > 1 %} — {{ b3[1] }}{% endif -%}</span></li>{%- endif -%}
          </ul>
        {%- endif -%}
        {%- if s.guarantee != blank -%}
          <p class="v-pdp__guarantee v-guarantee">{% render 'veloura-icon', name: 'check', size: 19 %}{{ s.guarantee }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.v-pdp { padding-block: 32px clamp(48px, 7vw, 80px); }
.v-pdp-community { display: flex; align-items: center; justify-content: center; gap: 9px; padding: 14px 24px; background: var(--v-canvas-secondary); border-bottom: 1px solid var(--v-border); margin: -32px 0 30px; }
.v-pdp-community svg { color: var(--v-rust); flex: none; }
.v-pdp-community p { margin: 0; font-family: var(--v-font-body); font-size: 1.0625rem; font-weight: 600; letter-spacing: 0.01em; color: var(--v-text); }
.v-pdp-community strong { color: var(--v-rust); font-weight: 700; }
.v-pdp__grid { display: grid; grid-template-columns: 1fr; gap: 28px; align-items: start; }
/* Let both columns shrink to the track width so content never forces the
   grid (and the page) wider than the viewport. */
.v-pdp__gallery, .v-pdp__buybox { min-width: 0; }
.v-pdp__buybox { overflow-wrap: break-word; }
.v-pdp__gallery { position: sticky; top: calc(var(--header-height, 64px) + 24px); }
.v-pdp__main { border-radius: var(--v-radius-md); overflow: hidden; aspect-ratio: 1 / 1; background: #cdb6a8; }
.v-pdp__main img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.15s ease; }
.v-pdp__ph { width: 100%; height: 100%; }
.v-pdp__thumbs { display: flex; gap: 10px; margin-top: 12px; max-width: 100%; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.v-pdp__thumbs::-webkit-scrollbar { display: none; }
.v-pdp__thumb { flex: none; width: 80px; height: 100px; border-radius: var(--v-radius-sm); overflow: hidden; border: 2px solid transparent; padding: 0; cursor: pointer; }
.v-pdp__thumb.is-active { border-color: var(--v-text); }
.v-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; }
.v-pdp__buybox { padding-top: 8px; scroll-margin-top: calc(var(--header-height, 64px) + 16px); }
.v-pdp__offer { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0 0 18px; padding: 10px 16px; background: var(--v-badge-popular); color: #fff; font-family: var(--v-font-body); font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; text-align: center; border-radius: var(--v-radius-sm); }
.v-pdp__offer svg { flex: none; }
.v-pdp .v-pdp__name { font-size: clamp(2.25rem, 4.8vw, 3.15rem); margin: 0 0 10px; }
.v-pdp__rating { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; }
.v-pdp__rating .v-stars { font-size: 1rem; }
.v-pdp__rating-text { font-size: 0.9375rem; font-weight: 500; color: var(--v-muted); }
.v-pdp .v-pdp__claim { font-size: clamp(1.95rem, 3.3vw, 2.4rem); line-height: 1.18; letter-spacing: -0.01em; margin: 0 0 18px; }
.v-pdp__tagline { font-family: var(--v-font-display); font-style: italic; font-weight: 500; font-size: clamp(1.55rem, 2.7vw, 1.9rem); line-height: 1.3; color: var(--v-text); margin: 16px 0 14px; }
.v-pdp__body { font-size: 1.125rem; line-height: 1.65; margin: 0 0 6px; }
.v-pdp__benefits { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 14px; }
.v-pdp__benefits li { display: flex; gap: 11px; align-items: flex-start; font-size: 1.125rem; line-height: 1.45; color: var(--v-text); }
.v-pdp__benefits svg { color: var(--v-rust); flex: none; margin-top: 2px; }
.v-pdp__variants { display: flex; flex-wrap: wrap; gap: 16px; margin: 22px 0 4px; }
.v-pdp__option { display: grid; gap: 6px; flex: 1 1 160px; }
.v-pdp__option-name { font-family: var(--v-font-body); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--v-text); }
.v-pdp__atc { margin-top: 22px; }
.v-pdp__atc .v-btn { font-size: 1.125rem; padding-block: 15px; gap: 10px; }
/* Size guide button + modal */
.v-pdp__titlerow { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
.v-pdp__titlerow .v-pdp__name { margin-bottom: 0; }
.v-pdp__sizeguide { flex: none; margin-top: 6px; display: inline-flex; align-items: center; gap: 7px; padding: 9px 18px; background: var(--v-white); border: 1px solid var(--v-border-strong); border-radius: 100px; font-family: var(--v-font-body); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--v-text); cursor: pointer; white-space: nowrap; transition: border-color 0.15s ease, color 0.15s ease; }
.v-pdp__sizeguide:hover { border-color: var(--v-rust); color: var(--v-rust); }
@media (max-width: 480px) { .v-pdp__sizeguide { padding: 8px 14px; font-size: 0.75rem; } }
.v-pdp__sizeguide svg { color: var(--v-rust); }
.v-sizeguide { border: none; padding: 0; background: transparent; max-width: 520px; width: 92vw; margin: auto; }
.v-sizeguide::backdrop { background: rgba(28, 16, 9, 0.5); }
.v-sizeguide__panel { position: relative; background: var(--v-canvas); border: 1px solid var(--v-border); border-radius: var(--v-radius-md); box-shadow: 0 24px 64px rgba(28, 16, 9, 0.28); padding: clamp(24px, 4vw, 40px); }
.v-sizeguide__close { position: absolute; top: 14px; right: 14px; background: none; border: none; padding: 6px; cursor: pointer; color: var(--v-muted); display: inline-flex; }
.v-sizeguide__close:hover { color: var(--v-text); }
.v-sizeguide__title { margin: 6px 0 12px; }
.v-sizeguide__note { font-size: 0.9375rem; color: var(--v-muted); line-height: 1.55; margin: 0 0 22px; }
.v-sizeguide__scroll { overflow-x: auto; }
.v-sizeguide__table { width: 100%; border-collapse: collapse; font-family: var(--v-font-body); }
.v-sizeguide__table th, .v-sizeguide__table td { padding: 12px 10px; text-align: center; border-bottom: 1px solid var(--v-border); font-size: 0.9375rem; color: var(--v-text); }
.v-sizeguide__table thead th { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--v-rust); border-bottom: 1.5px solid var(--v-border-strong); }
.v-sizeguide__table tbody tr:last-child td { border-bottom: none; }
.v-sizeguide__table tbody td:first-child { font-weight: 700; }
.v-sizeguide__table tbody tr:nth-child(even) { background: var(--v-canvas-secondary); }
.v-pdp__scarcity { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 14px 0 0; font-size: 0.9375rem; font-weight: 600; color: var(--v-scarcity); }
.v-pdp__atc .v-trust-badges { margin-top: 16px; }
.v-pdp__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--v-scarcity); display: inline-block; animation: v-pulse 1.6s ease-in-out infinite; }
.v-pdp .v-pdp__guarantee { margin: 22px 0 0; font-size: 1.125rem; font-weight: 700; }
@keyframes v-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
.v-pdp__form { margin: 0; }
/* Desktop: square photo sized to the fold height (so it's fully visible on
   one screen incl. thumbnails), buy box fills the rest. Wide container keeps
   the side white margins small. */
@media (min-width: 990px) {
  .v-pdp > .v-container { max-width: min(1440px, 92vw); }
  .v-pdp__grid { grid-template-columns: auto 1fr; gap: clamp(32px, 3vw, 56px); }
  .v-pdp__gallery { width: min(calc(100vh - var(--header-height, 64px) - 44px), 48vw, 780px); }
}
@media (max-width: 989px) {
  .v-pdp__gallery { position: static; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Product",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "text", "id": "community_text", "label": "Community bar text", "default": "Join <strong>5,400+</strong> women who chose Veloura" },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Velo-Lymph™ Enhanced" },
    { "type": "text", "id": "rating_text", "label": "Rating text (next to stars)", "default": "4.8 based on 471 Reviews" },
    { "type": "text", "id": "hero_claim", "label": "Hero claim", "default": "Reclaim your confidence. <strong>Smooth, sculpted legs in 8 weeks.</strong>" },
    { "type": "textarea", "id": "tagline", "label": "Tagline (italic)", "default": "The last legging you'll ever wish you'd found sooner." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "<strong>Not shapewear. Not compression.</strong> The only legging with a micro-massage weave, engineered to <strong>target cellulite</strong> while you live your life." },
    { "type": "text", "id": "bullet_1", "label": "Bullet 1", "default": "Wear the shorts again — no more avoiding the mirror, the pool, or summer" },
    { "type": "text", "id": "bullet_2", "label": "Bullet 2", "default": "Works automatically — no rollers, no creams, no extra routine" },
    { "type": "text", "id": "bullet_3", "label": "Bullet 3", "default": "Visible results in a few weeks — smoother-looking skin, just from wearing what you already wear" },
    { "type": "text", "id": "offer_banner", "label": "Offer banner (red)", "default": "Limited offer — Buy 1 Get 1 Free + Free Shipping" },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "text", "id": "scarcity", "label": "Scarcity text", "default": "Only 34 left in stock now" },
    { "type": "text", "id": "guarantee", "label": "Guarantee text (green)", "default": "30-day money-back guarantee — feel the difference or your money back" }
  ],
  "presets": [{ "name": "Veloura Product" }]
}
{% endschema %}
