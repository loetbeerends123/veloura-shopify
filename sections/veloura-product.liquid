{%- comment -%}
  Veloura — Product buy box (PRD §2.0–2.1).
  Sticky image gallery + buy box. Bundle pricing/selection is handled by the
  Kaching Bundles app widget (app embed); the theme renders the offer banner.
  Add-to-cart uses Dawn's <product-form> so the cart drawer works.
{%- endcomment -%}

{%- comment -%}
  ARCHIVED COPY — removed from the live PDP on 2026-08-10 at the owner's request.
  The markup below (tagline / body / bullets) still exists and renders as soon as
  the settings are filled in again. To restore, paste these values back into
  templates/product.json → sections.main.settings (or type them into the theme
  editor for this section):

    "tagline": "The last legging you'll ever wish you'd found sooner.",
    "body": "<strong>Not shapewear. Not compression.</strong> The only legging with a micro-massage weave, engineered to <strong>target cellulite</strong> while you live your life.",
    "bullet_1": "Wear the shorts again — no more avoiding the mirror, the pool, or summer",
    "bullet_2": "Works automatically — no rollers, no creams, no extra routine",
    "bullet_3": "Visible results in a few weeks — smoother-looking skin, just from wearing what you already wear",

  The same strings remain as the schema defaults at the bottom of this file, so a
  freshly added Veloura Product section will still start with them.
{%- endcomment -%}

{%- comment -%} Dawn's product-form custom element powers AJAX add-to-cart + drawer open {%- endcomment -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
-%}
<section class="v-pdp" data-section-id="{{ section.id }}">
  {%- if s.community_text != blank -%}
    <div class="v-pdp-community">
      {% render 'veloura-icon', name: 'heart', size: 16 %}
      <p>{{ s.community_text }}</p>
    </div>
  {%- endif -%}
  <div class="v-container">
    <div class="v-pdp__grid">

      {%- comment -%}
        Mobile copy of the offer banner: first in the DOM so the single-column
        layout shows the deal above the product photo, without scrolling. The
        desktop copy lives at the top of the buy box (see below); exactly one of
        the two is displayed per breakpoint, so screen readers only ever get one.
        No BOGO on the Bloom/Cellulite Shorts — hide the banner there.
      {%- endcomment -%}
      {%- unless product.handle contains 'shorts' -%}
        {%- if s.offer_banner != blank -%}
          <p class="v-pdp__offer v-pdp__offer--mobile">{% render 'veloura-icon', name: 'sparkle', size: 16 %}{{ s.offer_banner }}</p>
        {%- endif -%}
      {%- endunless -%}

      {%- comment -%} ---- Left: sticky gallery ---- {%- endcomment -%}
      <div class="v-pdp__gallery" data-gallery>
        <div class="v-pdp__main">
          {%- if product.images.size > 0 -%}
            <img data-gallery-main src="{{ product.featured_image | image_url: width: 1100 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1100" height="1375" fetchpriority="high">
          {%- else -%}
            <div class="v-pdp__ph v-placeholder" data-label="Veloura Legging — Front"></div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="v-pdp__thumbs">
            {%- for image in product.images limit: 7 -%}
              <button type="button" class="v-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-gallery-thumb
                      data-src="{{ image | image_url: width: 1100 }}" data-alt="{{ image.alt | escape }}">
                <img src="{{ image | image_url: width: 160 }}" alt="" width="80" height="100" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- comment -%}
          Colour → main-image map. The Kaching bundle app owns colour/size
          selection; this lets the left gallery swap to the chosen colour's
          photo when the shopper picks it in the bundle (see initColorImageSync).
        {%- endcomment -%}
        {%- liquid
          assign color_index = -1
          for opt in product.options_with_values
            assign onm = opt.name | downcase
            if onm == 'color' or onm == 'colour' or onm == 'kleur'
              assign color_index = forloop.index0
            endif
          endfor
        -%}
        {%- if color_index >= 0 -%}
          <script type="application/json" data-pdp-color-images>
          [
            {%- for v in product.variants -%}
              {"color": {{ v.options[color_index] | json }}, "src": {% if v.featured_image %}{{ v.featured_image | image_url: width: 1100 | json }}{% else %}null{% endif %}, "alt": {% if v.featured_image %}{{ v.featured_image.alt | default: product.title | json }}{% else %}{{ product.title | json }}{% endif %}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
          </script>
        {%- endif -%}
      </div>

      {%- comment -%} ---- Right: buy box ---- {%- endcomment -%}
      <div class="v-pdp__buybox" id="v-buybox">
        {%- comment -%} Desktop copy of the offer banner — hidden below 990px {%- endcomment -%}
        {%- unless product.handle contains 'shorts' -%}
          {%- if s.offer_banner != blank -%}
            <p class="v-pdp__offer v-pdp__offer--desktop">{% render 'veloura-icon', name: 'sparkle', size: 16 %}{{ s.offer_banner }}</p>
          {%- endif -%}
        {%- endunless -%}
        {%- if s.overline != blank -%}<span class="v-eyebrow">{{ s.overline }}</span>{%- endif -%}
        <div class="v-pdp__titlerow">
          <h1 class="v-h2 v-pdp__name">{{ product.title | default: 'Veloura Cellulite Legging' }}</h1>
          <button type="button" class="v-pdp__sizeguide" data-sizeguide-open>
            {% render 'veloura-icon', name: 'arrows', size: 16 %} Size Chart
          </button>
        </div>
        {%- if s.award_text != blank -%}
          <p class="v-pdp__award">{% render 'veloura-icon', name: 'award', size: 20 %}<span>{{ s.award_text }}</span></p>
        {%- endif -%}
        {%- if s.rating_text != blank -%}
          <div class="v-pdp__rating">
            <span class="v-stars">{% for i in (1..4) %}{% render 'veloura-icon', name: 'star', size: 16 %}{% endfor %}{% render 'veloura-icon', name: 'star-half', size: 16 %}</span>
            <span class="v-pdp__rating-text">{{ s.rating_text }}</span>
          </div>
        {%- endif -%}
        {%- if s.hero_claim != blank -%}<p class="v-pdp__claim v-serif">{{ s.hero_claim }}</p>{%- endif -%}
        {%- comment -%}
          Four benefit rows with line-art icons (PRD §2.1). Each row is icon +
          one short promise; edit them in the theme editor.
        {%- endcomment -%}
        {%- if s.usp_1 != blank or s.usp_2 != blank or s.usp_3 != blank or s.usp_4 != blank -%}
          <ul class="v-pdp__usps">
            {%- if s.usp_1 != blank -%}<li>{% render 'veloura-icon', name: 'thigh-smooth', size: 30 %}<span>{{ s.usp_1 }}</span></li>{%- endif -%}
            {%- if s.usp_2 != blank -%}<li>{% render 'veloura-icon', name: 'leg-tone', size: 30 %}<span>{{ s.usp_2 }}</span></li>{%- endif -%}
            {%- if s.usp_3 != blank -%}<li>{% render 'veloura-icon', name: 'bum-lift', size: 30 %}<span>{{ s.usp_3 }}</span></li>{%- endif -%}
            {%- if s.usp_4 != blank -%}<li>{% render 'veloura-icon', name: 'figure-slim', size: 30 %}<span>{{ s.usp_4 }}</span></li>{%- endif -%}
          </ul>
        {%- endif -%}

        <dialog class="v-sizeguide" data-sizeguide aria-label="Size chart">
          <div class="v-sizeguide__panel">
            <button type="button" class="v-sizeguide__close" data-sizeguide-close aria-label="Close">{% render 'veloura-icon', name: 'close', size: 18 %}</button>
            <span class="v-eyebrow">Find Your Fit</span>
            <h3 class="v-h3 v-sizeguide__title">Size Chart</h3>
            <p class="v-sizeguide__note">The fabric has 4-way stretch — <strong>if you're between sizes, we recommend sizing up for all-day comfort.</strong></p>
            <div class="v-sizeguide__scroll">
              {%- if product.handle contains 'shorts' -%}
                <table class="v-sizeguide__table">
                  <thead>
                    <tr><th>Size</th><th>Waist</th><th>Hip</th><th>Length</th></tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>58cm / 22.8"</td><td>72cm / 28.4"</td><td>47cm / 18.5"</td></tr>
                    <tr><td>M</td><td>62cm / 24.4"</td><td>76cm / 29.9"</td><td>48cm / 18.9"</td></tr>
                    <tr><td>L</td><td>66cm / 26.0"</td><td>80cm / 31.5"</td><td>49cm / 19.3"</td></tr>
                    <tr><td>XL</td><td>70cm / 27.6"</td><td>84cm / 33.1"</td><td>50cm / 19.7"</td></tr>
                    <tr><td>2XL</td><td>74cm / 29.1"</td><td>88cm / 34.7"</td><td>51cm / 20.1"</td></tr>
                    <tr><td>3XL</td><td>78cm / 30.7"</td><td>92cm / 36.2"</td><td>52cm / 20.5"</td></tr>
                  </tbody>
                </table>
              {%- else -%}
                <table class="v-sizeguide__table">
                  <thead>
                    <tr><th>Size</th><th>Waist</th><th>Hip</th><th>Length</th></tr>
                  </thead>
                  <tbody>
                    <tr><td>S</td><td>58cm / 22.8"</td><td>68cm / 26.7"</td><td>80cm / 31.4"</td></tr>
                    <tr><td>M</td><td>62cm / 24.4"</td><td>73cm / 28.7"</td><td>82cm / 32.3"</td></tr>
                    <tr><td>L</td><td>66cm / 25.9"</td><td>78cm / 30.7"</td><td>84cm / 33.1"</td></tr>
                    <tr><td>XL</td><td>70cm / 27.5"</td><td>83cm / 32.6"</td><td>86cm / 33.8"</td></tr>
                    <tr><td>2XL</td><td>74cm / 29.1"</td><td>87cm / 34.2"</td><td>88cm / 34.6"</td></tr>
                    <tr><td>3XL</td><td>78cm / 30.7"</td><td>94cm / 36.9"</td><td>90cm / 35.4"</td></tr>
                  </tbody>
                </table>
              {%- endif -%}
            </div>
          </div>
        </dialog>

        <div class="v-pdp__atc" data-atc-anchor>
          {%- if product != blank -%}
            <product-form class="product-form" data-section-id="{{ section.id }}">
              {%- form 'product', product, id: product_form_id, class: 'v-pdp__form', data-atc-form: 'true', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <input type="hidden" name="quantity" value="1" min="1">
                <button type="submit" name="add" class="v-btn v-btn--green v-btn--full v-btn--lg" {% unless current_variant.available %}disabled{% endunless %}>
                  <span class="v-atc-anim">{% render 'veloura-icon', name: 'bag', size: 20 %}</span>
                  <span>{% if current_variant.available %}{{ s.atc_label | default: 'Add to Cart' }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                  <span class="loading__spinner hidden" aria-hidden="true">
                    <svg focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
                  </span>
                </button>
              {%- endform -%}
            </product-form>
          {%- else -%}
            <button type="button" class="v-btn v-btn--green v-btn--full v-btn--lg"><span class="v-atc-anim">{% render 'veloura-icon', name: 'bag', size: 20 %}</span> {{ s.atc_label | default: 'Add to Cart' }}</button>
          {%- endif -%}

          {%- if s.scarcity != blank -%}
            <p class="v-pdp__scarcity"><span class="v-pdp__dot"></span>{{ s.scarcity }}</p>
          {%- endif -%}
          {% render 'veloura-trust-badges' %}
        </div>

        {%- if s.tagline != blank -%}<p class="v-pdp__tagline v-serif v-italic">{{ s.tagline }}</p>{%- endif -%}
        {%- if s.body != blank -%}<p class="v-pdp__body v-muted">{{ s.body }}</p>{%- endif -%}
        {%- if s.bullet_1 != blank or s.bullet_2 != blank or s.bullet_3 != blank -%}
          <ul class="v-pdp__benefits">
            {%- if s.bullet_1 != blank -%}{%- assign b1 = s.bullet_1 | split: ' — ' -%}<li>{% render 'veloura-icon', name: 'sparkle', size: 19 %}<span><strong>{{ b1[0] }}</strong>{%- if b1.size > 1 %} — {{ b1[1] }}{% endif -%}</span></li>{%- endif -%}
            {%- if s.bullet_2 != blank -%}{%- assign b2 = s.bullet_2 | split: ' — ' -%}<li>{% render 'veloura-icon', name: 'pulse', size: 19 %}<span><strong>{{ b2[0] }}</strong>{%- if b2.size > 1 %} — {{ b2[1] }}{% endif -%}</span></li>{%- endif -%}
            {%- if s.bullet_3 != blank -%}{%- assign b3 = s.bullet_3 | split: ' — ' -%}<li>{% render 'veloura-icon', name: 'calendar-clock', size: 19 %}<span><strong>{{ b3[0] }}</strong>{%- if b3.size > 1 %} — {{ b3[1] }}{% endif -%}</span></li>{%- endif -%}
          </ul>
        {%- endif -%}
        {%- if s.guarantee != blank -%}
          <p class="v-pdp__guarantee v-guarantee">{% render 'veloura-icon', name: 'check', size: 19 %}{{ s.guarantee }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.v-pdp { padding-block: 32px clamp(48px, 7vw, 80px); }
.v-pdp-community { display: flex; align-items: center; justify-content: center; gap: 9px; padding: 14px 24px; background: var(--v-canvas-secondary); border-bottom: 1px solid var(--v-border); margin: -32px 0 30px; }
.v-pdp-community svg { color: var(--v-rust); flex: none; }
.v-pdp-community p { margin: 0; font-family: var(--v-font-body); font-size: 1.1875rem; font-weight: 600; letter-spacing: 0.01em; color: var(--v-text); }
.v-pdp-community strong { color: var(--v-rust); font-weight: 700; }
.v-pdp__grid { display: grid; grid-template-columns: 1fr; gap: 28px; align-items: start; }
/* Single column (mobile/tablet): offer banner first, then photo, then buy box.
   Pulled tight to the photo instead of the full 28px grid gap. */
.v-pdp__grid > .v-pdp__offer { margin-bottom: -12px; }
/* Let both columns shrink to the track width so content never forces the
   grid (and the page) wider than the viewport. */
.v-pdp__gallery, .v-pdp__buybox { min-width: 0; }
.v-pdp__buybox { overflow-wrap: break-word; }
.v-pdp__gallery { position: sticky; top: calc(var(--header-height, 64px) + 24px); scroll-margin-top: calc(var(--header-height, 64px) + 12px); }
.v-pdp__main { border-radius: var(--v-radius-md); overflow: hidden; aspect-ratio: 1 / 1; background: #cdb6a8; }
.v-pdp__main img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.15s ease; }
.v-pdp__ph { width: 100%; height: 100%; }
.v-pdp__thumbs { display: flex; gap: 10px; margin-top: 12px; max-width: 100%; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.v-pdp__thumbs::-webkit-scrollbar { display: none; }
.v-pdp__thumb { flex: none; width: 80px; height: 100px; border-radius: var(--v-radius-sm); overflow: hidden; border: 2px solid transparent; padding: 0; cursor: pointer; }
.v-pdp__thumb.is-active { border-color: var(--v-text); }
.v-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; }
.v-pdp__buybox { padding-top: 8px; scroll-margin-top: calc(var(--header-height, 64px) + 16px); }
.v-pdp__offer { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0; padding: 10px 16px; background: var(--v-badge-popular); color: #fff; font-family: var(--v-font-body); font-size: 0.9375rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; text-align: center; border-radius: var(--v-radius-sm); }
.v-pdp__offer svg { flex: none; }
/* Two copies of the banner exist (grid child for mobile, buy-box child for
   desktop); exactly one is displayed per breakpoint. Simpler and steadier than
   moving one element between grid rows, which kept leaving a gap above the
   title when the spanning gallery inflated the banner's row. */
.v-pdp__offer--desktop { display: none; }
.v-pdp__grid > .v-pdp__offer--mobile { margin-bottom: -12px; }

/* Award line + benefit rows under the title. Tight stack: award sits straight
   under the title, rating under that, and a single hairline separates the
   block from the benefit rows — the rows themselves have no dividers, so the
   four promises read as one group instead of a table. */
.v-pdp__award { display: flex; align-items: center; gap: 8px; margin: 4px 0 5px; font-family: var(--v-font-body); font-size: 1rem; font-weight: 500; line-height: 1.3; color: var(--v-muted); }
.v-pdp__award svg { flex: none; color: var(--v-rust); }
/* The hairline belongs to the claim (it opens that block), not to the list */
.v-pdp__usps { list-style: none; margin: 0; padding: 0; }
.v-pdp__usps li { display: flex; align-items: center; gap: 14px; padding: 0; font-family: var(--v-font-body); font-size: 1.25rem; font-weight: 500; line-height: 1.35; color: var(--v-text); }
.v-pdp__usps li + li { margin-top: 4px; }
/* The icon box, not the text, sets the row height — keep it close to the line
   height or the rows drift apart. */
.v-pdp__usps svg { flex: none; width: 30px; height: 30px; color: var(--v-rust); }
.v-pdp .v-pdp__name { font-size: clamp(2.25rem, 4.8vw, 3.15rem); font-weight: 600; letter-spacing: -0.008em; margin: 0 0 10px; }
.v-pdp__rating { display: flex; align-items: center; gap: 10px; margin: 0 0 9px; }
.v-pdp__rating .v-stars { font-size: 1.125rem; }
.v-pdp__rating-text { font-size: 1.0625rem; font-weight: 600; color: var(--v-text); }
/* The emphasis rule only covers p/li, so pull the bold bits in here by hand */
.v-pdp__rating-text strong { color: var(--v-text); font-weight: 700; }
/* Sits between the rating and the benefit rows and opens that block, so it
   carries the hairline above it. */
.v-pdp .v-pdp__claim { font-size: clamp(1.95rem, 3.3vw, 2.4rem); line-height: 1.18; letter-spacing: -0.01em; margin: 0 0 13px; padding-top: 11px; border-top: 1px solid var(--v-border); }
.v-pdp__tagline { font-family: var(--v-font-display); font-style: italic; font-weight: 500; font-size: clamp(1.55rem, 2.7vw, 1.9rem); line-height: 1.3; color: var(--v-text); margin: 16px 0 14px; }
.v-pdp__body { font-size: 1.25rem; line-height: 1.65; margin: 0 0 6px; }
.v-pdp__benefits { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 14px; }
.v-pdp__benefits li { display: flex; gap: 11px; align-items: flex-start; font-size: 1.25rem; line-height: 1.45; color: var(--v-text); }
.v-pdp__benefits svg { color: var(--v-rust); flex: none; margin-top: 2px; }
.v-pdp__variants { display: flex; flex-wrap: wrap; gap: 16px; margin: 22px 0 4px; }
.v-pdp__option { display: grid; gap: 6px; flex: 1 1 160px; }
.v-pdp__option-name { font-family: var(--v-font-body); font-weight: 600; font-size: 0.9375rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--v-text); }
.v-pdp__atc { margin-top: 22px; }
.v-pdp__atc .v-btn { font-size: 1.125rem; padding-block: 15px; gap: 10px; }
/* Size guide button + modal */
.v-pdp__titlerow { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
/* min-width:0 lets the bold title shrink inside the flex row instead of pushing
   the size chart button out of line / off the edge. */
.v-pdp__titlerow .v-pdp__name { margin-bottom: 0; min-width: 0; overflow-wrap: break-word; }
.v-pdp__sizeguide { flex: none; margin-top: 6px; display: inline-flex; align-items: center; gap: 7px; padding: 10px 20px; background: var(--v-badge-popular); border: 1.5px solid var(--v-badge-popular); border-radius: 100px; font-family: var(--v-font-body); font-size: 0.875rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--v-white); cursor: pointer; white-space: nowrap; box-shadow: 0 2px 10px rgba(139, 26, 26, 0.22); transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease; }
.v-pdp__sizeguide svg { color: var(--v-white); }
.v-pdp__sizeguide:hover { background: #6F1414; border-color: #6F1414; box-shadow: 0 3px 14px rgba(139, 26, 26, 0.32); }
.v-pdp__sizeguide:hover svg { color: var(--v-white); }
@media (max-width: 480px) { .v-pdp__sizeguide { padding: 9px 15px; font-size: 0.8125rem; } }
.v-sizeguide { border: none; padding: 0; background: transparent; max-width: 520px; width: 92vw; margin: auto; }
.v-sizeguide::backdrop { background: rgba(28, 16, 9, 0.5); }
.v-sizeguide__panel { position: relative; background: var(--v-canvas); border: 1px solid var(--v-border); border-radius: var(--v-radius-md); box-shadow: 0 24px 64px rgba(28, 16, 9, 0.28); padding: clamp(24px, 4vw, 40px); }
.v-sizeguide__close { position: absolute; top: 14px; right: 14px; background: none; border: none; padding: 6px; cursor: pointer; color: var(--v-muted); display: inline-flex; }
.v-sizeguide__close:hover { color: var(--v-text); }
.v-sizeguide__title { margin: 6px 0 12px; }
.v-sizeguide__note { font-size: 1rem; font-weight: 500; color: var(--v-muted); line-height: 1.55; margin: 0 0 22px; }
.v-sizeguide__scroll { overflow-x: auto; }
.v-sizeguide__table { width: 100%; border-collapse: collapse; font-family: var(--v-font-body); }
.v-sizeguide__table th, .v-sizeguide__table td { padding: 13px 10px; text-align: center; border-bottom: 1px solid var(--v-border); font-size: 1.0625rem; font-weight: 600; color: var(--v-text); }
.v-sizeguide__table thead th { font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--v-white); background: var(--v-badge-popular); border-bottom: none; }
.v-sizeguide__table thead th:first-child { border-radius: var(--v-radius-sm) 0 0 var(--v-radius-sm); }
.v-sizeguide__table thead th:last-child { border-radius: 0 var(--v-radius-sm) var(--v-radius-sm) 0; }
.v-sizeguide__table tbody tr:last-child td { border-bottom: none; }
.v-sizeguide__table tbody td:first-child { font-weight: 800; }
.v-sizeguide__table tbody tr:nth-child(even) { background: var(--v-canvas-secondary); }
.v-pdp__scarcity { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 14px 0 0; font-size: 1.0625rem; font-weight: 600; color: var(--v-scarcity); }
.v-pdp__atc .v-trust-badges { margin-top: 16px; }
.v-pdp__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--v-scarcity); display: inline-block; animation: v-pulse 1.6s ease-in-out infinite; }
.v-pdp .v-pdp__guarantee { margin: 22px 0 0; font-size: 1.125rem; font-weight: 700; }
@keyframes v-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
.v-pdp__form { margin: 0; }
/* Desktop: square photo sized to the fold height (so it's fully visible on
   one screen incl. thumbnails), buy box fills the rest. Wide container keeps
   the side white margins small. */
@media (min-width: 990px) {
  .v-pdp > .v-container { max-width: min(1440px, 92vw); }
  .v-pdp__grid { grid-template-columns: auto 1fr; gap: clamp(32px, 3vw, 56px); }
  /* Two plain columns again — the banner rides inside the buy box on desktop,
     so no row spanning and nothing that can inflate a row above the title. */
  .v-pdp__offer--mobile { display: none; }
  .v-pdp__offer--desktop { display: flex; margin-bottom: 16px; }
  .v-pdp__gallery { width: min(calc(100vh - var(--header-height, 64px) - 44px), 48vw, 780px); }
}
@media (max-width: 989px) {
  .v-pdp__gallery { position: static; }
}
/* Mobile: keep the size chart button to the right of the title (top-right),
   with a slightly smaller title. */
@media (max-width: 749px) {
  .v-pdp__titlerow { align-items: flex-start; gap: 12px; }
  /* Semibold Playfair sets slightly wider than regular, so the mobile size stays
     a touch back to keep the title/size-chart row on one line. */
  .v-pdp .v-pdp__name { font-size: clamp(1.4375rem, 5.7vw, 1.9375rem); line-height: 1.18; }
  .v-pdp__sizeguide { margin-top: 4px; }
  .v-pdp__award { font-size: 0.9375rem; gap: 7px; margin: 3px 0 4px; }
  .v-pdp__rating { margin-bottom: 7px; }
  .v-pdp .v-pdp__claim { padding-top: 9px; margin-bottom: 11px; }
  .v-pdp__usps li { font-size: 1.1875rem; gap: 12px; }
  .v-pdp__usps li + li { margin-top: 3px; }
  .v-pdp__usps svg { width: 27px; height: 27px; }
}
{% endstylesheet %}

