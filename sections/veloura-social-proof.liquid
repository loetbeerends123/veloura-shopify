{%- comment -%} Veloura — Social Proof (PRD §1.5) {%- endcomment -%}
<section class="v-section v-social {% if section.settings.blush %}v-section--blush{% endif %}">
  <div class="v-container">
    <div class="v-social__head v-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="v-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="v-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="v-muted v-body" style="max-width:46ch;margin-top:14px;">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <div class="v-social__rating">
          <span class="v-stars">{% for i in (1..5) %}{% render 'veloura-icon', name: 'star', size: 16 %}{% endfor %}</span>
          <span class="v-label" style="font-size:0.75rem;color:var(--v-text);">{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="v-social__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="v-review v-reveal" {{ block.shopify_attributes }}>
            <span class="v-stars">{% for i in (1..5) %}{% render 'veloura-icon', name: 'star', size: 15 %}{% endfor %}</span>
            <p class="v-review__text">“{{ block.settings.text }}”</p>
            <div class="v-review__meta">
              <span class="v-review__avatar">{{ block.settings.name | slice: 0 }}</span>
              <span><strong style="color:var(--v-text);font-weight:600;">{{ block.settings.name }}</strong> · {{ block.settings.badge | default: 'Verified Buyer' }}</span>
            </div>
          </article>
        {%- elsif block.type == 'expert' -%}
          <article class="v-review v-review--expert v-reveal" {{ block.shopify_attributes }}>
            <span class="v-social__expert-icon">{% render 'veloura-icon', name: 'shield', size: 26 %}</span>
            <p class="v-review__text v-italic" style="font-size:1.0625rem;">“{{ block.settings.text }}”</p>
            <div class="v-review__meta"><strong style="color:var(--v-text);font-weight:600;">{{ block.settings.name }}</strong></div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.link_label != blank -%}
      <div class="v-social__more v-reveal">
        <a href="{{ section.settings.link_url | default: '#' }}" class="v-link-cta" style="color:var(--v-text);">{{ section.settings.link_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.v-social__head { max-width: 640px; margin-bottom: 40px; }
.v-social__head .v-h2 { margin: 0; }
.v-social__rating { display: flex; align-items: center; gap: 12px; margin-top: 18px; }
.v-social__grid { columns: 3 280px; column-gap: 20px; }
.v-social__grid > * { margin-bottom: 20px; }
.v-review--expert { border-left: 3px solid var(--v-rust); background: var(--v-canvas-secondary); }
.v-social__expert-icon { color: var(--v-rust); display: inline-flex; margin-bottom: 6px; }
.v-social__more { text-align: center; margin-top: 36px; }
@media (max-width: 749px) { .v-social__grid { columns: 1; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Social Proof",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "checkbox", "id": "blush", "label": "Blush background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real structural change" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Join thousands of women who stopped treating the symptom and started treating the cause." },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9/5 from 2,400+ reviews" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read all reviews" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review", "default": "I've spent thousands on creams that did nothing. After wearing these for 6 weeks, the back of my thighs are noticeably smoother." },
        { "type": "text", "id": "name", "label": "Name", "default": "Sarah M." },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Verified Buyer" }
      ]
    },
    {
      "type": "expert",
      "name": "Expert callout",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Quote", "default": "I recommend these to patients as an adjunct to professional treatments. The continuous micro-compression aids lymphatic drainage effectively between clinic visits." },
        { "type": "text", "id": "name", "label": "Attribution", "default": "— Dr J. Chen, MD" }
      ]
    }
  ],
  "presets": [{
    "name": "Veloura Social Proof",
    "blocks": [
      { "type": "review", "settings": { "text": "I've spent thousands on creams that did nothing. After finding the science behind Veloura and wearing them for 6 weeks, the back of my thighs are noticeably smoother. The fabric is thick and compressive but surprisingly comfortable.", "name": "Sarah M." } },
      { "type": "expert" },
      { "type": "review", "settings": { "text": "My daily uniform. I bought the 3-pack because I wanted to wear them every day. My legs feel incredibly light at the end of the day — no more heavy feeling. The dimpling is definitely fading.", "name": "Elena F." } },
      { "type": "review", "settings": { "text": "Loving this compression. Comfortable enough to wear close-up, all day.", "name": "Tiff" } }
    ]
  }]
}
{% endschema %}
