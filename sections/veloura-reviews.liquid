{%- comment -%} Veloura — Customer Reviews (PRD §2.6) {%- endcomment -%}
<section class="v-section v-reviews">
  <div class="v-container" style="max-width:1000px;">
    {%- if section.settings.heading != blank -%}
      <h2 class="v-h2 v-reviews__heading v-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="v-reviews__summary v-card v-reveal">
      <div class="v-reviews__score">
        <span class="v-reviews__num v-serif">{{ section.settings.score | default: '4.8' }}</span>
        <span class="v-stars">{% for i in (1..4) %}{% render 'veloura-icon', name: 'star', size: 16 %}{% endfor %}{% render 'veloura-icon', name: 'star-half', size: 16 %}</span>
        <span class="v-body-sm v-muted">{{ section.settings.count_text | default: 'Based on 471 reviews' }}</span>
      </div>
      {%- if section.settings.show_write -%}
        <button type="button" class="v-btn v-btn--outline" data-review-toggle aria-expanded="false" aria-controls="v-review-form">{{ section.settings.write_label | default: 'Write a Review' }}</button>
      {%- endif -%}
    </div>

    {%- if section.settings.show_write -%}
      <div class="v-reviews__write" id="v-review-form" data-review-form hidden>
        {%- form 'contact', id: 'ReviewForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="v-reviews__form-success">{% render 'veloura-icon', name: 'check', size: 16 %} Thank you — your review was received and will appear once approved.</p>
          {%- else -%}
            <p class="v-reviews__form-intro">Share your experience. Reviews are checked before they appear on the site.</p>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="product-review">
          <div class="v-reviews__form-row">
            <input class="v-reviews__input" type="text" name="contact[name]" placeholder="Your name" aria-label="Your name" required>
            <input class="v-reviews__input" type="email" name="contact[email]" placeholder="Your email" aria-label="Your email" required>
          </div>
          <div class="v-reviews__form-row">
            <select class="v-reviews__input" name="contact[Rating]" aria-label="Rating">
              <option value="★★★★★ (5)">★★★★★ — 5 stars</option>
              <option value="★★★★☆ (4)">★★★★ — 4 stars</option>
              <option value="★★★☆☆ (3)">★★★ — 3 stars</option>
              <option value="★★☆☆☆ (2)">★★ — 2 stars</option>
              <option value="★☆☆☆☆ (1)">★ — 1 star</option>
            </select>
            <input class="v-reviews__input" type="text" name="contact[Review title]" placeholder="Review title (optional)" aria-label="Review title">
          </div>
          <textarea class="v-reviews__input v-reviews__textarea" name="contact[Review]" placeholder="Tell us about your experience…" aria-label="Your review" required></textarea>
          <button type="submit" class="v-btn v-btn--green v-reviews__submit">Submit review</button>
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="v-reviews__list">
      {%- for block in section.blocks -%}
        <article class="v-reviews__item v-reveal" {{ block.shopify_attributes }}>
          <header class="v-reviews__top">
            <span class="v-review__avatar">{{ block.settings.name | slice: 0 }}</span>
            <div class="v-reviews__who">
              <strong>{{ block.settings.name }}</strong>
              {%- if block.settings.verified -%}<span class="v-badge v-badge--verified">Verified Purchase</span>{%- endif -%}
            </div>
            <span class="v-stars v-reviews__stars">{% for i in (1..5) %}{% render 'veloura-icon', name: 'star', size: 14 %}{% endfor %}</span>
          </header>
          {%- if block.settings.variant != blank -%}<p class="v-reviews__variant">{{ block.settings.variant }}</p>{%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="v-reviews__title">{{ block.settings.title }}</h3>{%- endif -%}
          <p class="v-reviews__body">{{ block.settings.body }}</p>
          {%- if block.settings.photo_1 != blank or block.settings.photo_2 != blank -%}
            <div class="v-review__photos v-reviews__photos">
              {%- if block.settings.photo_1 != blank -%}<img src="{{ block.settings.photo_1 | image_url: width: 480 }}" alt="Customer photo — {{ block.settings.name | escape }}" width="120" height="120" loading="lazy">{%- endif -%}
              {%- if block.settings.photo_2 != blank -%}<img src="{{ block.settings.photo_2 | image_url: width: 480 }}" alt="Customer photo — {{ block.settings.name | escape }}" width="120" height="120" loading="lazy">{%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.v-reviews__heading { text-align: center; margin-bottom: 28px; }
.v-reviews__summary { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 28px 32px; margin-bottom: 28px; }
.v-reviews__score { display: flex; flex-direction: column; gap: 8px; }
/* No "Write a Review" button: center the score instead of leaving dead space */
.v-reviews__score:only-child { margin-inline: auto; align-items: center; text-align: center; }
.v-reviews__num { font-size: 3.5rem; line-height: 1; }
.v-reviews__list { display: grid; gap: 0; }
.v-reviews__item { padding: 26px 0; border-bottom: 1px solid var(--v-border); }
.v-reviews__item:last-child { border-bottom: 0; }
.v-reviews__top { display: flex; align-items: center; gap: 12px; }
.v-reviews__who { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.v-reviews__who strong { font-size: 0.8125rem; font-weight: 600; }
.v-reviews__stars { margin-left: auto; }
.v-reviews__variant { font-size: 0.75rem; color: var(--v-muted); margin: 10px 0 0; }
.v-reviews__title { font-family: var(--v-font-body); font-weight: 600; font-size: 1.0625rem; margin: 8px 0 6px; }
.v-reviews__body { font-size: 1.0625rem; line-height: 1.7; color: var(--v-muted); margin: 0; }
.v-reviews__photos { display: flex; gap: 10px; margin: 14px 0 0; }
.v-reviews__photos img { width: 112px; height: 112px; object-fit: cover; border-radius: var(--v-radius-sm); border: 1px solid var(--v-border); }
/* Write-a-review form */
.v-reviews__write { max-width: 640px; margin: 0 auto 30px; padding: 26px; border: 1px solid var(--v-border); border-radius: var(--v-radius-md); background: var(--v-canvas-secondary); }
.v-reviews__write[hidden] { display: none; }
.v-reviews__form-intro { margin: 0 0 16px; font-size: 0.9375rem; color: var(--v-muted); }
.v-reviews__form-success { display: flex; align-items: center; gap: 8px; margin: 0 0 4px; color: var(--v-green); font-weight: 600; }
.v-reviews__form-row { display: flex; gap: 12px; margin-bottom: 12px; }
.v-reviews__input { width: 100%; padding: 12px 14px; border: 1px solid var(--v-border-strong); border-radius: var(--v-radius-sm); background: var(--v-white); font-family: var(--v-font-body); font-size: 1rem; color: var(--v-text); }
.v-reviews__input:focus { outline: none; border-color: var(--v-rust); }
.v-reviews__textarea { min-height: 120px; resize: vertical; margin-bottom: 14px; }
.v-reviews__submit { width: 100%; }
@media (max-width: 749px) {
  .v-reviews__summary { flex-direction: column; align-items: flex-start; }
  .v-reviews__stars { margin-left: 0; width: 100%; }
  .v-reviews__form-row { flex-direction: column; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Reviews",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Customers Are Saying" },
    { "type": "text", "id": "score", "label": "Score", "default": "4.8" },
    { "type": "text", "id": "count_text", "label": "Count text", "default": "Based on 471 reviews" },
    { "type": "checkbox", "id": "show_write", "label": "Show 'Write a Review' button + form", "default": true, "info": "Opens a form that emails the review to your store contact address for approval." },
    { "type": "text", "id": "write_label", "label": "Write button label", "default": "Write a Review" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Faith B." },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true },
        { "type": "text", "id": "variant", "label": "Variant line", "default": "Size: S · Colour: Slate" },
        { "type": "text", "id": "title", "label": "Title", "default": "I've tried everything. These work." },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Far more comfortable than medical-grade garments and actually something I can wear out." },
        { "type": "image_picker", "id": "photo_1", "label": "Customer photo 1" },
        { "type": "image_picker", "id": "photo_2", "label": "Customer photo 2" }
      ]
    }
  ],
  "presets": [{
    "name": "Veloura Reviews",
    "blocks": [
      { "type": "review", "settings": { "name": "Faith B.", "variant": "Size: S · Colour: Slate", "title": "I've tried everything. These work.", "body": "I have had cellulite since I was 16. I am now 34. I have tried every cream, treatment, and piece of clothing on the market. Nothing moved the needle until these. After 5 weeks of wearing them almost every day I can genuinely see a difference in the dimpling on my thighs. Far more comfortable than medical-grade garments." } },
      { "type": "review", "settings": { "name": "Eva S.", "variant": "Size: M · Colour: Black", "title": "Day one results are real.", "body": "I'm sceptical by nature but I just bought them because I kept seeing them. This is different. My thighs feel more taut than they've felt from clean eating alone." } }
    ]
  }]
}
{% endschema %}
