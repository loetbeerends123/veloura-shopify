{%- comment -%}
  Veloura — "Complete Your Protocol" cart-page upsell (PRD §7, §10.2).
  Uses its own AJAX form (initCartUpsell in veloura.js) so adding updates
  the cart page in place via the Section Rendering API instead of opening
  the drawer over the page. Falls back to a normal POST without JS.
{%- endcomment -%}
{%- liquid
  assign up = section.settings.product
  if up == blank and settings.veloura_upsell_product != blank
    assign up = settings.veloura_upsell_product
  endif
  if up == blank and settings.veloura_upsell_handle != blank
    assign up = all_products[settings.veloura_upsell_handle]
  endif
  assign in_cart = false
  if up != blank
    for line in cart.items
      if line.product.id == up.id
        assign in_cart = true
        break
      endif
    endfor
  endif
  assign up_variant = up.selected_or_first_available_variant
  assign up_compare = up_variant.compare_at_price
  assign up_compare_fallback = settings.veloura_upsell_compare_price | times: 100
  if up_compare == blank or up_compare < up_compare_fallback
    assign up_compare = up_compare_fallback
  endif
  if up_compare <= up_variant.price
    assign up_compare = nil
  else
    assign up_save_percent = up_compare | minus: up_variant.price | times: 100 | divided_by: up_compare
  endif
-%}
{%- if cart != empty and up != blank -%}
<section class="v-section v-cart-upsell" data-v-upsell data-section-id="{{ section.id }}">
  <div class="v-container v-cart-upsell__container">
    <h2 class="v-h3 v-cart-upsell__heading">{{ section.settings.heading }}</h2>
    <hr class="v-hairline v-cart-upsell__rule">

    <div class="v-card v-cart-upsell__card {% if in_cart %}is-added{% endif %}">
      <div class="v-cart-upsell__media">
        {%- if up.featured_image -%}
          <img src="{{ up.featured_image | image_url: width: 280 }}" alt="{{ up.featured_image.alt | default: up.title | escape }}" width="140" height="168">
        {%- else -%}
          <span class="v-placeholder" data-label="Cellulite Shorts"></span>
        {%- endif -%}
      </div>
      <div class="v-cart-upsell__body">
        <h3 class="v-h3 v-cart-upsell__title">{{ up.title }}</h3>
        <p class="v-muted v-body-sm">{{ section.settings.body }}</p>
        <span class="v-badge v-badge--clinical">Clinical Results</span>
        {%- if up_compare -%}
          <span class="v-badge v-badge--save">Save {{ up_save_percent }}% today</span>
        {%- endif -%}
        {%- if section.settings.reassurance != blank -%}
          <p class="v-cart-upsell__reassure v-guarantee">{% render 'veloura-icon', name: 'check', size: 14 %}{{ section.settings.reassurance }}</p>
        {%- endif -%}
      </div>
      <div class="v-cart-upsell__action">
        {%- if up_compare -%}
          <span class="v-price v-price--sale">
            <span class="v-price__compare">{{ up_compare | money }}</span>
            <span class="v-price__now">{{ up_variant.price | money }}</span>
          </span>
        {%- else -%}
          <span class="v-price">{{ up_variant.price | money }}</span>
        {%- endif -%}
        {%- if in_cart -%}
          <span class="v-cart-upsell__added">{% render 'veloura-icon', name: 'check', size: 16 %} Added to your protocol</span>
        {%- else -%}
          <form action="{{ routes.cart_add_url }}" method="post" data-v-upsell-form>
            <input type="hidden" name="id" value="{{ up_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="v-btn v-btn--rust-outline" {% unless up_variant.available %}disabled{% endunless %}>
              {%- if up_variant.available %}Add to Order{% else %}Sold out{% endif -%}
            </button>
          </form>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.v-cart-upsell__container { max-width: 1100px; }
.v-cart-upsell__heading { font-size: 1.75rem; margin-bottom: 18px; }
.v-cart-upsell__rule { margin-bottom: 24px; }
.v-cart-upsell__title { font-size: 1.375rem; }
.v-cart-upsell__card { display: grid; grid-template-columns: auto 1fr auto; gap: 20px; align-items: center; padding: 24px; }
.v-cart-upsell__card.is-added { opacity: 0.75; }
.v-cart-upsell__media img, .v-cart-upsell__media .v-placeholder { width: 140px; height: 168px; object-fit: cover; border-radius: var(--v-radius-md); display: block; }
.v-cart-upsell__body { display: grid; gap: 8px; }
.v-cart-upsell__body .v-badge { justify-self: start; }
.v-cart-upsell__action { display: grid; gap: 12px; justify-items: end; text-align: right; }
.v-cart-upsell__added { display: inline-flex; align-items: center; gap: 6px; color: var(--v-green); font-size: 0.8125rem; font-weight: 500; }
/* Desktop: bigger card so the upsell reads clearly instead of hiding at the bottom of the cart */
@media (min-width: 750px) {
  .v-cart-upsell__heading { font-size: 2.125rem; }
  .v-cart-upsell__card { gap: 32px; padding: 40px; }
  .v-cart-upsell__title { font-size: 1.875rem; }
  .v-cart-upsell__body { gap: 12px; }
  .v-cart-upsell__body p.v-body-sm { font-size: 1.0625rem; line-height: 1.6; }
  .v-cart-upsell__body .v-badge { font-size: 0.75rem; padding: 7px 16px; }
  .v-cart-upsell__reassure { font-size: 0.9375rem; }
  .v-cart-upsell__action { gap: 16px; }
  .v-cart-upsell__action .v-price { font-size: 1.75rem; }
  .v-cart-upsell__action .v-price__compare { font-size: 0.7em; }
  .v-cart-upsell__action .v-btn { padding: 17px 34px; font-size: 0.875rem; min-width: 200px; }
}
@media (max-width: 749px) {
  .v-cart-upsell__card { grid-template-columns: auto 1fr; gap: 14px; padding: 18px; }
  .v-cart-upsell__media img, .v-cart-upsell__media .v-placeholder { width: 100px; height: 120px; }
  /* One tidy row: price left, a full-size pill button filling the rest */
  .v-cart-upsell__action { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 14px; text-align: left; border-top: 1px solid var(--v-border); padding-top: 14px; }
  .v-cart-upsell__action .v-price { font-size: 1.1875rem; font-weight: 700; }
  .v-cart-upsell__action form { flex: 1; }
  .v-cart-upsell__action .v-btn { width: 100%; min-height: 48px; font-size: 0.875rem; border-width: 1.5px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Cart Upsell",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete Your Protocol" },
    { "type": "product", "id": "product", "label": "Upsell product (Cellulite Shorts)" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Essential for <strong>24/7 lymphatic support</strong> and targeted compression." },
    { "type": "text", "id": "reassurance", "label": "Reassurance line (green)", "default": "Free shipping & 30-day money-back guarantee" }
  ],
  "presets": [{ "name": "Veloura Cart Upsell" }]
}
{% endschema %}
