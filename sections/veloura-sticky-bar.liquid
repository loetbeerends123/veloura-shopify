{%- comment -%}
  Veloura — Sticky bottom cart bar (PRD §2.7, §10.3).
  Styled after the Kaching Bundles sticky ATC (see assets/veloura.css) and the
  button scrolls to the bundle widget rather than adding to cart, so shoppers
  pick size and colour there (initStickyAtc in assets/veloura.js).
{%- endcomment -%}
<div class="v-sticky-bar" data-sticky-bar aria-hidden="true" inert>
  <div class="v-container v-sticky-bar__inner">
    {%- if product.featured_image -%}
      <img class="v-sticky-bar__thumb" src="{{ product.featured_image | image_url: width: 160 }}" alt="" width="54" height="54">
    {%- else -%}
      <span class="v-sticky-bar__thumb v-placeholder"></span>
    {%- endif -%}
    <span class="v-sticky-bar__name">{{ product.title | default: 'Veloura Cellulite Legging' }}</span>
    <button type="button" class="v-btn v-btn--green" data-sticky-atc>{{ section.settings.cta_label | default: 'Start My Transformation' }}</button>
  </div>
</div>

{% schema %}
{
  "name": "Veloura Sticky Bar",
  "tag": "section",
  "class": "veloura-section veloura-sticky",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Start My Transformation" }
  ],
  "presets": [{ "name": "Veloura Sticky Bar" }]
}
{% endschema %}
