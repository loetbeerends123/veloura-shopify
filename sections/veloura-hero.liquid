{%- comment -%} Veloura — Home Hero (PRD §1.1): full-bleed image, overlaid copy, left fade {%- endcomment -%}
{%- liquid
  if section.settings.image != blank
    assign hero_src = section.settings.image | image_url: width: 2400
  else
    assign hero_src = 'veloura-hero.png' | asset_url
  endif
-%}
<section class="v-hero" data-hero-overlay style="--hero-img: url('{{ hero_src }}');">
  <div class="v-hero__bg" role="img" aria-label="{{ section.settings.image.alt | default: 'Model wearing Veloura leggings' | escape }}"></div>
  <div class="v-hero__fade"></div>

  <div class="v-hero__inner v-container">
    <div class="v-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="v-eyebrow v-reveal" data-delay="1">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="v-h1 v-hero__title v-reveal" data-delay="2">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="v-hero__sub v-reveal" data-delay="3">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="v-btn v-btn--green v-hero__cta v-reveal" data-delay="4">
          {{ section.settings.button_label }} {% render 'veloura-icon', name: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.v-hero { position: relative; overflow: hidden; background: var(--v-canvas); isolation: isolate; }
.v-hero__bg {
  position: absolute; inset: 0; z-index: -2;
  background-image: var(--hero-img);
  background-size: cover;
  background-position: 72% center;
}
/* Left canvas fade — keeps overlaid copy (and the transparent header) readable */
.v-hero__fade {
  position: absolute; inset: 0; z-index: -1;
  background:
    linear-gradient(to right,
      var(--v-canvas) 0%,
      var(--v-canvas) 20%,
      rgba(250, 246, 244, 0.78) 38%,
      rgba(250, 246, 244, 0.15) 56%,
      transparent 68%);
}
.v-hero__inner { display: flex; align-items: center; min-height: min(82vh, 720px); }
.v-hero__copy { max-width: 480px; padding-block: 64px; }
.v-hero__title { margin: 0 0 20px; }
.v-hero__sub { color: var(--v-muted); font-size: 1.0625rem; line-height: 1.7; max-width: 360px; margin: 0 0 28px; }
.v-hero__cta { align-self: flex-start; }

/* Desktop: pull the hero up under a transparent header so the image reaches into it */
@media (min-width: 990px) {
  .has-hero-overlay #MainContent > .shopify-section:first-child { margin-top: calc(-1 * var(--header-height, 84px)); }
  .has-hero-overlay .header-wrapper { background: transparent !important; border-bottom: 0 !important; }
  .has-hero-overlay .header-wrapper.scrolled-past-header { background: var(--v-canvas) !important; box-shadow: var(--v-shadow-card); }
  .v-hero__inner { padding-top: var(--header-height, 84px); }
}

/* Mobile: image on top, taller, copy still overlaid bottom-left with extra bottom fade */
@media (max-width: 989px) {
  .v-hero__bg { background-position: 70% center; }
  .v-hero__fade {
    background:
      linear-gradient(to top, var(--v-canvas) 6%, rgba(250,246,244,0.65) 30%, transparent 60%),
      linear-gradient(to right, var(--v-canvas) 0%, rgba(250,246,244,0.4) 45%, transparent 75%);
  }
  .v-hero__inner { align-items: flex-end; min-height: 78vh; }
  .v-hero__copy { padding-block: 32px 40px; max-width: none; }
  .v-hero__sub { max-width: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Hero",
  "tag": "section",
  "class": "veloura-section veloura-hero-section",
  "settings": [
    { "type": "paragraph", "content": "Leave the image empty to use the built-in hero photo (assets/veloura-hero.png)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Velo-Lymph™ Technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop hiding your legs." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The only legging engineered to treat cellulite at the root through clinical micro-compression." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop The Veloura Legging" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional override)" }
  ],
  "presets": [{ "name": "Veloura Hero" }]
}
{% endschema %}
