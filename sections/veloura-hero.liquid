{%- comment -%} Veloura — Home Hero (PRD §1.1) {%- endcomment -%}
<section class="v-hero" data-section-id="{{ section.id }}">
  <div class="v-hero__grid">
    <div class="v-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="v-eyebrow v-reveal" data-delay="1">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="v-h1 v-hero__title v-reveal" data-delay="2">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="v-hero__sub v-reveal" data-delay="3">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="v-btn v-btn--green v-hero__cta v-reveal" data-delay="4">
          {{ section.settings.button_label }} {% render 'veloura-icon', name: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>

    <div class="v-hero__media v-reveal" data-delay="2">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1400 }}"
             alt="{{ section.settings.image.alt | escape }}"
             width="1400" height="1700" fetchpriority="high">
      {%- else -%}
        <div class="v-hero__ph v-placeholder" data-label="Model · Veloura Legging"></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.v-hero { border-bottom: 1px solid var(--v-border); background: var(--v-canvas); overflow: hidden; }
.v-hero__grid { display: grid; grid-template-columns: 1fr 1fr; min-height: 540px; align-items: stretch; }
.v-hero__copy {
  display: flex; flex-direction: column; justify-content: center;
  padding: 64px clamp(24px, 5vw, 80px);
  max-width: 620px; margin-left: auto; width: 100%;
}
.v-hero__title { margin: 0 0 20px; }
.v-hero__sub { color: var(--v-muted); font-size: 0.9375rem; line-height: 1.7; max-width: 340px; margin: 0 0 28px; }
.v-hero__cta { align-self: flex-start; }
.v-hero__media { position: relative; }
.v-hero__media img,
.v-hero__ph { position: absolute; inset: -20px 0 -20px 0; width: 100%; height: calc(100% + 40px); object-fit: cover; }
.v-hero__ph { inset: 0; height: 100%; }

@media (max-width: 989px) {
  .v-hero__grid { grid-template-columns: 1fr; }
  .v-hero__media { order: -1; height: 60vh; min-height: 360px; }
  .v-hero__media img, .v-hero__ph { position: relative; inset: 0; height: 100%; }
  .v-hero__copy { padding: 48px 24px; margin: 0; max-width: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Hero",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Velo-Lymph™ Technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop hiding your legs." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The only legging engineered to treat cellulite at the root through clinical micro-compression." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop The Veloura Legging" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Veloura Hero" }]
}
{% endschema %}
