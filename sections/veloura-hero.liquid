{%- comment -%} Veloura — Home Hero (PRD §1.1): full-bleed photo background with a dark rust-toned scrim behind the copy, so the photo shows edge-to-edge instead of sitting beside a solid canvas panel. {%- endcomment -%}
{%- liquid
  if section.settings.image != blank
    assign hero_src = section.settings.image | image_url: width: 2400
    assign hero_alt = section.settings.image.alt | default: 'Model wearing Veloura leggings'
    assign hero_w = section.settings.image.width
    assign hero_h = section.settings.image.height
  else
    assign hero_src = 'veloura-hero.jpg' | asset_url
    assign hero_alt = 'Model wearing Veloura anti-cellulite leggings'
    assign hero_w = 2400
    assign hero_h = 1018
  endif
-%}
<section class="v-hero">
  <div class="v-hero__media">
    <img class="v-hero__img" src="{{ hero_src }}" alt="{{ hero_alt | escape }}" width="{{ hero_w }}" height="{{ hero_h }}" fetchpriority="high">
    <div class="v-hero__scrim" aria-hidden="true"></div>
  </div>
  <div class="v-hero__copy">
    {%- if section.settings.eyebrow != blank -%}
      <span class="v-eyebrow v-reveal" data-delay="1">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="v-h1 v-hero__title v-reveal" data-delay="2">
      <span class="v-hero__title-line">{{ section.settings.heading }}</span>
      {%- if section.settings.heading_accent != blank -%}
        <span class="v-hero__title-accent">{{ section.settings.heading_accent }}</span>
      {%- endif -%}
    </h1>
    {%- if section.settings.subheading != blank -%}
      <p class="v-hero__sub v-reveal" data-delay="3">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="v-btn v-btn--green v-hero__cta v-reveal" data-delay="4">
        {{ section.settings.button_label }} {% render 'veloura-icon', name: 'arrow-right', size: 16 %}
      </a>
    {%- endif -%}
    {%- if section.settings.urgency != blank -%}
      <p class="v-hero__urgency v-urgency v-reveal" data-delay="5">{{ section.settings.urgency }}</p>
    {%- endif -%}
    {%- if section.settings.proof_text != blank -%}
      <div class="v-hero__proof v-reveal" data-delay="5">
        <span class="v-stars">{% for i in (1..4) %}{% render 'veloura-icon', name: 'star', size: 14 %}{% endfor %}{% render 'veloura-icon', name: 'star-half', size: 14 %}</span>
        <span>{{ section.settings.proof_text }}</span>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
/* Full-bleed hero: the photo covers the whole section; copy sits in a dark
   rust-toned scrim on the left that fades into clear photo on the right,
   so the image reads across the full width instead of a solid canvas panel. */
.v-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  min-height: min(82vh, 720px);
}
.v-hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.v-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 68% 38%;
  display: block;
}
.v-hero__scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(100deg,
    rgba(28, 16, 9, 0.72) 0%,
    rgba(28, 16, 9, 0.52) 32%,
    rgba(28, 16, 9, 0.18) 58%,
    rgba(28, 16, 9, 0) 76%);
}
.v-hero__copy {
  position: relative;
  z-index: 1;
  max-width: 620px;
  padding: 96px clamp(28px, 6vw, 96px);
}
/* Scoped under .v-hero to outrank veloura.css component font-sizes */
.v-hero .v-eyebrow {
  font-size: 0.9375rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  margin-bottom: 20px;
  color: var(--v-rust-light);
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.3);
}
/* Two-tone headline: cream upright line, then an italic rust line - the
   accent line carries the emotional payoff, set apart in weight and colour. */
.v-hero .v-hero__title {
  font-size: clamp(2.875rem, 4.8vw, 4.5rem);
  line-height: 1.08;
  margin: 0 0 22px;
  font-weight: 400;
}
.v-hero__title-line,
.v-hero__title-accent {
  display: block;
  text-shadow: 0 4px 24px rgba(0, 0, 0, 0.35);
}
.v-hero__title-line { color: var(--v-canvas); }
.v-hero__title-accent {
  color: var(--v-rust-light);
  font-style: italic;
  font-weight: 500;
  margin-top: 0.05em;
}
.v-hero .v-hero__sub {
  color: rgba(250, 246, 244, 0.92);
  font-size: 1.3125rem;
  line-height: 1.6;
  max-width: 42ch;
  margin: 0 0 32px;
  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.3);
}
.v-hero .v-hero__sub strong { color: var(--v-rust-light); }
.v-hero .v-hero__cta { font-size: 1.0625rem; padding: 16px 40px; }
.v-hero .v-hero__urgency { margin: 18px 0 0; font-size: 1rem; }
.v-hero__proof {
  display: inline-flex; align-items: center; gap: 10px;
  margin-top: 22px;
  font-family: var(--v-font-body); font-size: 0.9375rem; font-weight: 500;
  color: rgba(250, 246, 244, 0.88);
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
}
.v-hero__proof .v-stars { display: inline-flex; color: var(--v-star); }

/* Tablet: tighten the copy column, keep the same full-bleed treatment */
@media (max-width: 989px) and (min-width: 750px) {
  .v-hero { min-height: 64vh; }
  .v-hero__copy { padding: 64px 40px; max-width: 520px; }
  .v-hero .v-hero__title { font-size: clamp(2.5rem, 5vw, 3.25rem); }
  .v-hero .v-hero__sub { font-size: 1.125rem; }
}

/* Mobile: same full-bleed photo, scrim widened so type stays readable
   over whatever part of the image sits behind it. */
@media (max-width: 749px) {
  .v-hero { min-height: 88vh; align-items: flex-end; }
  .v-hero__scrim {
    background: linear-gradient(180deg,
      rgba(28, 16, 9, 0.15) 0%,
      rgba(28, 16, 9, 0.55) 55%,
      rgba(28, 16, 9, 0.82) 100%);
  }
  .v-hero__copy { padding: 0 24px 48px; max-width: none; }
  .v-hero .v-hero__title { font-size: clamp(2.375rem, 9.5vw, 3rem); margin: 0 0 16px; }
  .v-hero .v-hero__sub { font-size: 1.125rem; line-height: 1.55; margin: 0 0 24px; }
  .v-hero .v-hero__cta { justify-content: center; font-size: 0.9375rem; letter-spacing: 0.08em; padding: 16px 14px; white-space: nowrap; }
  .v-hero .v-hero__urgency { text-align: center; font-size: 0.9375rem; }
  .v-hero__proof { justify-content: center; margin-top: 18px; font-size: 0.875rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Hero",
  "tag": "section",
  "class": "veloura-section veloura-hero-section",
  "settings": [
    { "type": "paragraph", "content": "Leave the image empty to use the built-in product photo (assets/veloura-hero.jpg)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Velo-Lymph™ Technology" },
    { "type": "text", "id": "heading", "label": "Heading — line 1 (cream)", "default": "Stop hiding" },
    { "type": "text", "id": "heading_accent", "label": "Heading — line 2 (italic rust)", "default": "your legs." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The only legging engineered to <strong>treat cellulite at the root</strong> through <strong>clinical micro-compression</strong>." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop The Veloura Legging" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "urgency", "label": "Urgency line (red)" },
    { "type": "text", "id": "proof_text", "label": "Proof line (stars + text)", "default": "4.8 · from 471 reviews" },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional override)" }
  ],
  "presets": [{ "name": "Veloura Hero" }]
}
{% endschema %}
