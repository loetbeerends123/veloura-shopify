{%- comment -%} Veloura — Home Hero (PRD §1.1): product photo contained in-section, left→right fade {%- endcomment -%}
{%- liquid
  if section.settings.image != blank
    assign hero_src = section.settings.image | image_url: width: 2400
    assign hero_alt = section.settings.image.alt | default: 'Model wearing Veloura leggings'
    assign hero_w = section.settings.image.width
    assign hero_h = section.settings.image.height
  else
    assign hero_src = 'veloura-hero.jpg' | asset_url
    assign hero_alt = 'Model wearing Veloura anti-cellulite leggings'
    assign hero_w = 2400
    assign hero_h = 1018
  endif
-%}
<section class="v-hero">
  <img class="v-hero__img" src="{{ hero_src }}" alt="{{ hero_alt | escape }}" width="{{ hero_w }}" height="{{ hero_h }}" fetchpriority="high">
  <div class="v-hero__fade"></div>

  {%- comment -%} Mobile-only floating proof chip over the photo card {%- endcomment -%}
  {%- if section.settings.proof_text != blank -%}
    <div class="v-hero__proof">
      <span class="v-stars">{% for i in (1..4) %}{% render 'veloura-icon', name: 'star', size: 14 %}{% endfor %}{% render 'veloura-icon', name: 'star-half', size: 14 %}</span>
      <span>{{ section.settings.proof_text }}</span>
    </div>
  {%- endif -%}

  <div class="v-hero__inner v-container">
    <div class="v-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="v-eyebrow v-reveal" data-delay="1">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="v-h1 v-hero__title v-reveal" data-delay="2">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="v-hero__sub v-reveal" data-delay="3">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="v-btn v-btn--green v-hero__cta v-reveal" data-delay="4">
          {{ section.settings.button_label }} {% render 'veloura-icon', name: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
      {%- if section.settings.urgency != blank -%}
        <p class="v-hero__urgency v-urgency v-reveal" data-delay="5">{{ section.settings.urgency }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* Image is clipped strictly to the hero; the section defines its own height.
   The hero is a normal flow section, so it sits below the header (no overlap). */
.v-hero {
  position: relative;
  overflow: hidden;
  background: var(--v-canvas);
  border-bottom: 1px solid var(--v-border);
  isolation: isolate;
}
.v-hero__img {
  position: absolute; inset: 0; z-index: -2;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: 72% 40%;
}
/* Left -> right fade into the canvas colour for strong text contrast */
.v-hero__fade {
  position: absolute; inset: 0; z-index: -1;
  background: linear-gradient(
    to right,
    rgba(250, 246, 244, 0.99) 0%,
    rgba(250, 246, 244, 0.98) 40%,
    rgba(250, 246, 244, 0.90) 56%,
    rgba(250, 246, 244, 0.45) 75%,
    rgba(250, 246, 244, 0) 93%
  );
}
.v-hero__inner { display: flex; align-items: center; min-height: min(78vh, 660px); }
.v-hero__copy { max-width: 600px; padding-block: 64px; margin-left: clamp(12px, 6vw, 88px); }
/* Scoped under .v-hero to outrank veloura.css's .v-h1 / .v-btn / .v-urgency font-sizes */
.v-hero .v-hero__title { font-size: clamp(3.75rem, 8vw, 6.5rem); font-weight: 700; margin: 0 0 24px; text-shadow: 0 1px 0 rgba(250, 246, 244, 0.6); }
.v-hero .v-hero__sub { color: var(--v-text); font-size: 1.625rem; line-height: 1.55; max-width: 460px; margin: 0 0 36px; }
.v-hero .v-hero__cta { align-self: flex-start; font-size: 1.25rem; padding: 17px 44px; }
.v-hero .v-hero__urgency { margin: 20px 0 0; font-size: 1.25rem; }

/* Tablet */
@media (max-width: 989px) {
  .v-hero__img { object-position: 72% 40%; }
  .v-hero__inner { min-height: 64vh; }
  .v-hero__copy { max-width: 60%; }
}

/* Proof chip is a mobile-only element */
.v-hero__proof { display: none; }

/* Mobile: framed photo card with a cream fade rising from the bottom and the
   same espresso-on-canvas copy colours as desktop, plus a floating review chip
   straddling the card's bottom edge. */
@media (max-width: 749px) {
  .v-hero {
    position: relative;
    display: flex; flex-direction: column;
    margin: 12px 16px 0;
    min-height: 82vh; min-height: 82svh;
    overflow: visible;
    border-bottom: 0;
    background: transparent;
  }
  .v-hero__img {
    border-radius: var(--v-radius-md);
    box-shadow: var(--v-shadow-card);
    object-position: 72% 26%;
  }
  .v-hero__fade {
    border-radius: var(--v-radius-md);
    background: linear-gradient(
      to top,
      rgba(250, 246, 244, 0.97) 0%,
      rgba(250, 246, 244, 0.92) 28%,
      rgba(250, 246, 244, 0.60) 52%,
      rgba(250, 246, 244, 0) 76%
    );
  }

  .v-hero__inner { flex: 1; order: 1; display: flex; align-items: flex-end; min-height: 0; }
  .v-hero__copy { max-width: none; width: 100%; padding: 120px 6px 34px; margin-left: 0; text-align: left; }
  .v-hero .v-hero__title { font-size: clamp(2.5rem, 10.5vw, 3.4rem); line-height: 1.07; margin: 0 0 14px; text-shadow: 0 1px 0 rgba(250, 246, 244, 0.6); }
  .v-hero .v-hero__sub { font-size: 1.125rem; line-height: 1.55; max-width: 30ch; margin: 0 0 22px; }
  .v-hero .v-hero__cta { width: 100%; justify-content: center; font-size: 0.9375rem; letter-spacing: 0.08em; padding: 17px 14px; white-space: nowrap; box-shadow: 0 6px 20px rgba(28, 16, 9, 0.18); }
  .v-hero .v-hero__urgency { font-size: 0.9375rem; font-weight: 600; margin: 14px 0 0; text-align: center; }

  .v-hero__proof {
    display: inline-flex; align-items: center; gap: 9px;
    align-self: center;
    order: 2;
    position: relative; z-index: 2;
    margin-bottom: -22px;
    background: var(--v-white);
    border: 1px solid var(--v-border);
    border-radius: var(--v-radius-lg);
    padding: 11px 20px;
    box-shadow: var(--v-shadow-card);
    font-family: var(--v-font-body); font-size: 0.875rem; font-weight: 600; color: var(--v-text);
  }
  .v-hero__proof .v-stars { display: inline-flex; color: var(--v-star); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Hero",
  "tag": "section",
  "class": "veloura-section veloura-hero-section",
  "settings": [
    { "type": "paragraph", "content": "Leave the image empty to use the built-in product photo (assets/veloura-hero.jpg)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Velo-Lymph™ Technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop hiding your legs." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The only legging engineered to <strong>treat cellulite at the root</strong> through <strong>clinical micro-compression</strong>." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop The Veloura Legging" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "urgency", "label": "Urgency line (red)", "default": "⚡ Selling fast — limited stock this week" },
    { "type": "text", "id": "proof_text", "label": "Proof chip (mobile, over photo)", "default": "4.8 · from 471 reviews" },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional override)" }
  ],
  "presets": [{ "name": "Veloura Hero" }]
}
{% endschema %}
