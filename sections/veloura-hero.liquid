{%- comment -%} Veloura — Home Hero (PRD §1.1): full-bleed product photo, overlaid copy, soft left fade {%- endcomment -%}
{%- liquid
  if section.settings.image != blank
    assign hero_src = section.settings.image | image_url: width: 2400
    assign hero_alt = section.settings.image.alt | default: 'Model wearing Veloura leggings'
  else
    assign hero_src = 'veloura-hero.png' | asset_url
    assign hero_alt = 'Model wearing Veloura anti-cellulite leggings'
  endif
-%}
<section class="v-hero" data-hero-overlay>
  <img class="v-hero__img" src="{{ hero_src }}" alt="{{ hero_alt | escape }}" fetchpriority="high">
  <div class="v-hero__fade"></div>

  <div class="v-hero__inner v-container">
    <div class="v-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="v-eyebrow v-reveal" data-delay="1">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="v-h1 v-hero__title v-reveal" data-delay="2">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="v-hero__sub v-reveal" data-delay="3">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="v-btn v-btn--green v-hero__cta v-reveal" data-delay="4">
          {{ section.settings.button_label }} {% render 'veloura-icon', name: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.v-hero { position: relative; overflow: hidden; background: var(--v-canvas); isolation: isolate; }
.v-hero__img {
  position: absolute; inset: 0; z-index: -2;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: 60% 40%;
}
/* Soft canvas fade on the LEFT only — copy stays readable, product stays visible */
.v-hero__fade {
  position: absolute; inset: 0; z-index: -1;
  background: linear-gradient(to right,
    var(--v-canvas) 0%,
    rgba(250, 246, 244, 0.86) 16%,
    rgba(250, 246, 244, 0.4) 32%,
    transparent 48%);
}
.v-hero__inner { display: flex; align-items: center; min-height: min(80vh, 680px); }
.v-hero__copy { max-width: 430px; padding-block: 64px; }
.v-hero__title { margin: 0 0 20px; }
.v-hero__sub { color: var(--v-muted); font-size: 1.0625rem; line-height: 1.7; max-width: 340px; margin: 0 0 28px; }
.v-hero__cta { align-self: flex-start; }

/* Desktop: pull the hero up under a transparent header so the photo reaches into it */
@media (min-width: 990px) {
  .has-hero-overlay #MainContent > .shopify-section:first-child { margin-top: calc(-1 * var(--header-height, 84px)); }
  .has-hero-overlay .header-wrapper { background: transparent !important; border-bottom: 0 !important; }
  .has-hero-overlay .header-wrapper.scrolled-past-header { background: var(--v-canvas) !important; box-shadow: var(--v-shadow-card); }
  .v-hero__inner { padding-top: var(--header-height, 84px); }
}

/* Mobile: taller photo, copy overlaid bottom-left with a bottom fade for legibility */
@media (max-width: 989px) {
  .v-hero__img { object-position: 64% 38%; }
  .v-hero__fade {
    background:
      linear-gradient(to top, var(--v-canvas) 4%, rgba(250,246,244,0.6) 26%, transparent 55%),
      linear-gradient(to right, var(--v-canvas) 0%, rgba(250,246,244,0.35) 40%, transparent 70%);
  }
  .v-hero__inner { align-items: flex-end; min-height: 76vh; }
  .v-hero__copy { padding-block: 32px 40px; max-width: none; }
  .v-hero__sub { max-width: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Hero",
  "tag": "section",
  "class": "veloura-section veloura-hero-section",
  "settings": [
    { "type": "paragraph", "content": "Leave the image empty to use the built-in product photo (assets/veloura-hero.png)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Velo-Lymph™ Technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop hiding your legs." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The only legging engineered to treat cellulite at the root through clinical micro-compression." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop The Veloura Legging" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional override)" }
  ],
  "presets": [{ "name": "Veloura Hero" }]
}
{% endschema %}
