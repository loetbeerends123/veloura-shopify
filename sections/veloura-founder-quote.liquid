{%- comment -%} Veloura — Founder quote block (PRD §5.5) {%- endcomment -%}
<section class="v-section v-section--dark v-founder">
  <div class="v-narrow" style="max-width:720px;text-align:center;">
    <span class="v-founder__mark v-serif" aria-hidden="true">&ldquo;</span>
    <blockquote class="v-founder__quote v-italic v-reveal">{{ section.settings.quote }}</blockquote>
    <p class="v-founder__attr v-reveal" data-delay="1">
      <span class="v-founder__name">{{ section.settings.attribution }}</span>
      {%- if section.settings.sub != blank -%}<span class="v-founder__sub">{{ section.settings.sub }}</span>{%- endif -%}
    </p>
    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="v-founder__cta v-reveal" data-delay="2">
        <a href="{{ section.settings.cta_link }}" class="v-btn v-btn--green v-btn--lg">
          {% render 'veloura-icon', name: 'bag', size: 18 %} {{ section.settings.cta_label }}
        </a>
        {%- if section.settings.cta_note != blank -%}<p class="v-founder__cta-note">{{ section.settings.cta_note }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.v-founder { background: var(--v-canvas-dark); }
.v-founder__mark { display: block; font-size: 6rem; line-height: 0.5; color: var(--v-rust); margin-bottom: 24px; }
.v-founder__quote { font-size: clamp(1.625rem, 3.6vw, 2.125rem); line-height: 1.45; color: #fff; margin: 0 0 32px; }
.v-founder__attr { display: grid; gap: 8px; margin: 0; }
.v-founder__name { font-size: 0.875rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--v-rust-light); }
.v-founder__sub { font-size: 1rem; color: rgba(255,255,255,0.8); }
.v-founder__cta { margin-top: 36px; }
.v-founder__cta-note { margin: 14px 0 0; font-size: 0.9375rem; color: rgba(255,255,255,0.8); }
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Founder Quote",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "We didn't set out to make another legging. We set out to engineer a solution that respects the biological reality of women's bodies. Veloura is where scientific rigour meets daily wear." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "The Founders" },
    { "type": "text", "id": "sub", "label": "Sub-attribution", "default": "Veloura Clinical Innovations" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Start My Protocol" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "cta_note", "label": "Note under CTA", "default": "30-Day Clinical Trial Guarantee + Free Returns" }
  ],
  "presets": [{ "name": "Veloura Founder Quote" }]
}
{% endschema %}
