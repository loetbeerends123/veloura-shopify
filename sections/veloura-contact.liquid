{%- comment -%} Veloura — Contact form (matches Contact reference) {%- endcomment -%}
<section class="v-section v-contact">
  <div class="v-contact__wrap">
    <h1 class="v-h1 v-contact__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="v-contact__sub v-muted">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- form 'contact', class: 'v-contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="v-contact__success">{{ section.settings.success_text | default: "Thank you — we'll be in touch shortly." }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="v-contact__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="v-contact__row">
        <div class="v-contact__field">
          <input class="v-contact__input" type="text" name="contact[First name]" placeholder="First name" autocomplete="given-name" aria-label="First name">
        </div>
        <div class="v-contact__field">
          <input class="v-contact__input" type="text" name="contact[Last name]" placeholder="Last name" autocomplete="family-name" aria-label="Last name">
        </div>
      </div>
      <div class="v-contact__field">
        <input class="v-contact__input" type="tel" name="contact[Phone]" placeholder="Phone" autocomplete="tel" aria-label="Phone">
      </div>
      <div class="v-contact__field">
        <input class="v-contact__input" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Email" autocomplete="email" required aria-label="Email">
      </div>
      <div class="v-contact__field">
        <textarea class="v-contact__input v-contact__textarea" name="contact[body]" placeholder="Message" required aria-label="Message">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="v-btn v-btn--green v-btn--full v-contact__send">{{ section.settings.button_label | default: 'Send' }}</button>
    {%- endform -%}

    {%- if section.settings.email != blank or section.settings.hours != blank -%}
      <div class="v-contact__info">
        {%- if section.settings.email != blank -%}<p class="v-contact__email">{{ section.settings.email }}</p>{%- endif -%}
        {%- if section.settings.hours != blank -%}<p class="v-contact__hours v-muted">{{ section.settings.hours }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.v-contact__wrap { width: 100%; max-width: 560px; margin-inline: auto; padding-inline: var(--v-gutter); text-align: left; }
.v-contact__title { font-size: clamp(2.5rem, 5vw, 3.5rem); margin: 0 0 6px; }
.v-contact__sub { font-size: 1.1875rem; margin: 0 0 28px; }
.v-contact__form { display: grid; gap: 18px; margin: 24px 0 0; }
.v-contact__row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.v-contact__input {
  width: 100%;
  font-family: var(--v-font-body); font-size: 1.125rem; color: var(--v-text);
  background: #F7F1ED;
  border: 1px solid var(--v-border);
  border-radius: var(--v-radius-sm);
  padding: 20px 22px;
  transition: border-color 0.15s ease, background 0.15s ease;
}
.v-contact__input::placeholder { color: var(--v-muted); opacity: 1; }
.v-contact__input:focus { outline: none; border-color: var(--v-green); background: #fff; }
.v-contact__textarea { min-height: 150px; resize: vertical; }
.v-contact__send { margin-top: 6px; border-radius: var(--v-radius-lg); padding: 20px 0; font-size: 1.0625rem; }
.v-contact__success { background: rgba(58,125,68,0.1); color: var(--v-green); padding: 14px 16px; border-radius: var(--v-radius-sm); font-size: 0.9375rem; }
.v-contact__error { background: rgba(192,57,43,0.08); color: var(--v-scarcity); padding: 14px 16px; border-radius: var(--v-radius-sm); font-size: 0.9375rem; }
.v-contact__info { margin-top: 28px; display: grid; gap: 4px; }
.v-contact__email { font-size: 1.125rem; margin: 0; }
.v-contact__hours { font-size: 1.0625rem; margin: 0; }
@media (max-width: 749px) { .v-contact__row { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura Contact",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in Touch" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We're here to support your journey." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send Message" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "Thank you — we'll be in touch shortly." },
    { "type": "text", "id": "email", "label": "Email (optional)", "default": "info@her-veloura.com" },
    { "type": "text", "id": "hours", "label": "Hours (optional)", "default": "Customer Support: Monday–Friday, 9am–6pm GMT" }
  ],
  "presets": [{ "name": "Veloura Contact" }]
}
{% endschema %}
