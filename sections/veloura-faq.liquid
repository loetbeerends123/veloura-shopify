{%- comment -%} Veloura — FAQ accordion with a "Need help?" contact rail (PRD §2.3, §10.5) {%- endcomment -%}
<section class="v-section {% if section.settings.blush %}v-section--blush{% endif %} v-faq-section">
  <div class="v-container">
    <div class="v-faq2__grid">

      <aside class="v-faq2__help v-reveal">
        {%- if section.settings.help_heading != blank -%}
          <h2 class="v-h3 v-faq2__help-title">{{ section.settings.help_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.help_text != blank -%}
          <p class="v-faq2__help-text">{{ section.settings.help_text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '/pages/contact' }}" class="v-btn v-btn--green v-faq2__help-btn">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </aside>

      <div class="v-faq2__main v-reveal" data-delay="1">
        <div class="v-section-head v-faq2__head">
          {%- if section.settings.eyebrow != blank -%}<span class="v-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="v-h2">{{ section.settings.heading }}</h2>
        </div>

        <div class="v-faq" data-faq>
          {%- for block in section.blocks -%}
            {%- assign panel_id = section.id | append: '-faq-' | append: forloop.index -%}
            <div class="v-faq__item" {{ block.shopify_attributes }}>
              <button type="button" class="v-faq__q" aria-expanded="false" aria-controls="{{ panel_id }}">
                <span>{{ block.settings.question }}</span>
                <span class="v-faq__icon" aria-hidden="true"></span>
              </button>
              <div class="v-faq__a" id="{{ panel_id }}" role="region" hidden>
                <div class="v-faq__a-inner">{{ block.settings.answer }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
.v-faq2__grid { display: grid; grid-template-columns: 380px 1fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
.v-faq2__help { text-align: center; }
.v-faq2__help-title { font-size: clamp(1.875rem, 3vw, 2.375rem); margin: 0 0 16px; }
.v-faq2__help-text { color: var(--v-muted); font-size: 1.1875rem; line-height: 1.65; margin: 0 0 28px; }
.v-faq2__help-btn { width: 100%; font-size: 0.875rem; padding-block: 18px; }
.v-faq2__head { margin-bottom: 20px; }
/* Refined accordion: airy rounded cards instead of plain divider rows. */
.v-faq2__main .v-faq { display: grid; gap: 12px; }
.v-faq2__main .v-faq__item,
.v-faq2__main .v-faq__item:last-child {
  border: 1px solid var(--v-border);
  border-radius: var(--v-radius-md);
  background: var(--v-white);
  padding: 2px 24px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.v-faq2__main .v-faq__item:hover { border-color: var(--v-border-strong); }
.v-faq2__main .v-faq__item.is-open { border-color: var(--v-rust); box-shadow: var(--v-shadow-card); }
.v-faq2__main .v-faq__q { padding: 22px 0; }
.v-faq2__main .v-faq__icon::before,
.v-faq2__main .v-faq__icon::after { background: var(--v-rust); }
.v-faq2__main .v-faq__a-inner { padding: 0 0 22px; }
@media (min-width: 850px) {
  .v-faq2__help { position: sticky; top: calc(var(--header-height, 64px) + 32px); }
}
@media (max-width: 849px) {
  .v-faq2__grid { grid-template-columns: 1fr; gap: 40px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Veloura FAQ",
  "tag": "section",
  "class": "veloura-section",
  "settings": [
    { "type": "checkbox", "id": "blush", "label": "Blush background", "default": false },
    { "type": "header", "content": "\"Need help?\" rail (left)" },
    { "type": "text", "id": "help_heading", "label": "Help heading", "default": "Need help?" },
    { "type": "textarea", "id": "help_text", "label": "Help text", "default": "Our team is here for you, Monday to Friday, 8:30 am–7:00 pm." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact our support" },
    { "type": "url", "id": "button_link", "label": "Button link (leave empty for /pages/contact)" },
    { "type": "header", "content": "FAQ (right)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How quickly will I see results?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Most customers notice a feeling of lightness within the first wear. Visible skin texture improvement typically begins around week 2–3 of daily wear. Structural changes are most visible at 6–8 weeks of consistent use." }
      ]
    }
  ],
  "presets": [{
    "name": "Veloura FAQ",
    "blocks": [
      { "type": "qa", "settings": { "question": "How quickly will I see results?", "answer": "Most customers notice a feeling of lightness within the first wear as stagnant fluid starts to move. Visible skin texture improvement typically begins around week 2–3 of daily wear. Structural changes — the real reduction in dimpling — are most visible at 6–8 weeks of consistent use." } },
      { "type": "qa", "settings": { "question": "I've tried leggings before. Why is this different?", "answer": "Standard compression leggings squeeze superficially, which can actually restrict circulation and worsen the appearance of cellulite over time. Veloura's VELO-LYMPH™ fabric uses 47 mapped micro-pressure points engineered to stimulate lymphatic flow with every step — it works with your body's movement, not against it." } },
      { "type": "qa", "settings": { "question": "How do I find the right size?", "answer": "We recommend sizing up if you're between sizes for maximum comfort during all-day wear. Our size guide is available on the product image gallery. When in doubt, the fabric has 4-way stretch to accommodate." } },
      { "type": "qa", "settings": { "question": "How long does shipping take?", "answer": "UK standard shipping: 3–5 business days. UK express: 1–2 business days. EU: 5–8 days. International: 7–14 days. All orders over £65 include free standard UK shipping." } },
      { "type": "qa", "settings": { "question": "Can I wear them every day?", "answer": "Absolutely — and we encourage it. The clinical results are cumulative: the more consistently you wear them, the better the structural improvement. Machine wash cold, hang dry. They maintain their therapeutic properties for 80+ washes." } },
      { "type": "qa", "settings": { "question": "What if they don't work for me?", "answer": "We offer a 30-day Clinical Trial Guarantee. If you don't see measurable improvement in skin texture within 30 days of daily wear, contact us for a full refund — no returns required, no questions asked." } }
    ]
  }]
}
{% endschema %}
