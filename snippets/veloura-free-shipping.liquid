{%- comment -%}
  Veloura — free-shipping progress.
  Shows how far the cart still is from the free-shipping threshold, or confirms
  it once reached. Threshold comes from settings.veloura_free_shipping_threshold
  (in pounds; 0 hides the whole block).

  Lives in the cart drawer footer and the cart page footer — both are re-rendered
  by Dawn's cart API on every quantity change, so the bar updates on its own.

  Usage: {% render 'veloura-free-shipping' %}
{%- endcomment -%}
{%- liquid
  assign threshold = settings.veloura_free_shipping_threshold | default: 0 | times: 100
  assign spent = cart.total_price | default: 0
  assign remaining = threshold | minus: spent
  assign pct = 0
  if threshold > 0
    assign pct = spent | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
{%- if threshold > 0 -%}
  <div class="v-ship{% if remaining <= 0 %} v-ship--unlocked{% endif %}">
    <p class="v-ship__label">
      {%- if remaining <= 0 -%}
        {% render 'veloura-icon', name: 'check', size: 16 %}
        <span><strong>Free shipping unlocked</strong> — no delivery charge at checkout.</span>
      {%- else -%}
        {% render 'veloura-icon', name: 'bag', size: 16 %}
        <span>You're <strong>{{ remaining | money }}</strong> away from <strong>free shipping</strong>.</span>
      {%- endif -%}
    </p>
    <div
      class="v-ship__track"
      role="progressbar"
      aria-label="Progress towards free shipping"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ pct }}"
    >
      <span class="v-ship__fill" style="width: {{ pct }}%;"></span>
    </div>
  </div>
{%- endif -%}
