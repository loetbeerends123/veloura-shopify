{%- comment -%}
  Veloura logo lockup — emblem (lymph-droplet monogram) + wordmark.
  Used in the header in place of the plain shop name.
{%- endcomment -%}
<span class="veloura-logo">
  <svg class="veloura-logo__mark" viewBox="0 0 40 40" width="34" height="34" fill="none" aria-hidden="true">
    <circle cx="20" cy="20" r="18.5" stroke="currentColor" stroke-width="1" opacity="0.55"/>
    <path d="M11.5 12.5 L20 27.5 L28.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M20 7.5 C20 7.5 16.8 11 16.8 13.2 a3.2 3.2 0 0 0 6.4 0 C23.2 11 20 7.5 20 7.5 Z" fill="currentColor" opacity="0.9"/>
  </svg>
  <span class="veloura-logo__text">
    <span class="veloura-logo__word">Veloura</span>
    <span class="veloura-logo__tag">Clinical Apparel</span>
  </span>
</span>
