{%- comment -%}
  Veloura inline SVG icons (line-art, currentColor).
  Usage: {% render 'veloura-icon', name: 'droplet', size: 24 %}
  Names: droplet, wave, diamond, sparkle, shield, cross, pulse, flask,
         molecule, check, star, award, lock, arrows, plus, search, bag,
         close, chevron, clock
         Body set (PDP benefit rows): thigh-smooth, leg-tone, bum-lift,
         figure-slim
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
-%}
{%- case name -%}
  {%- when 'droplet' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5C12 3.5 5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 12 3.5 12 3.5Z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/></svg>
  {%- when 'wave' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9c2.5-3 5-3 7.5 0S15 12 17.5 9 22 6 22 9"/><path d="M2 15c2.5-3 5-3 7.5 0S15 18 17.5 15s4.5-3 4.5 0"/></svg>
  {%- when 'diamond' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 22 12 12 22 2 12 12 2Z"/><path d="M7 12h10M12 7v10" opacity=".4"/></svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2c.6 5 1.8 8 8 10-6.2 2-7.4 5-8 10-.6-5-1.8-8-8-10 6.2-2 7.4-5 8-10Z"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 5 5.5v5c0 4.4 3 8 7 9.5 4-1.5 7-5.1 7-9.5v-5L12 2.5Z"/><path d="m9 11.5 2 2 4-4"/></svg>
  {%- when 'cross' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="18" rx="1.5"/><rect x="3" y="9" width="18" height="6" rx="1.5"/><path d="m4 4 16 16" stroke-width="1.2"/></svg>
  {%- when 'pulse' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12h4l2-6 4 14 3-9 2 1h5"/></svg>
  {%- when 'flask' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3"/><path d="M7.5 15h9" opacity=".5"/></svg>
  {%- when 'molecule' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="17" r="2.2"/><circle cx="19" cy="17" r="2.2"/><path d="M10.5 6.8 6.5 15M13.5 6.8 17.5 15M7 17h10"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12 5 5L20 6"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.8 6.2 20.9l1.1-6.5L2.6 9.3l6.5-.9L12 2.5Z"/></svg>
  {%- when 'star-half' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><defs><linearGradient id="vhalf"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="currentColor" stop-opacity="0.25"/></linearGradient></defs><path fill="url(#vhalf)" d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.8 6.2 20.9l1.1-6.5L2.6 9.3l6.5-.9L12 2.5Z"/></svg>
  {%- when 'award' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5.5"/><path d="m9 13.8-1.5 7 4.5-2.5 4.5 2.5-1.5-7"/><path d="m12 6.4 1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2L8.8 8.7l2.2-.3 1-2Z" opacity=".55"/></svg>
  {%- comment -%}
    Body icons for the PDP benefit rows — line-art versions of the reference
    set (thigh + dimples, toned leg, lifted glutes, slimmed silhouette), drawn
    on the same 24-grid and stroke weight as the rest of the set so they read
    as one family instead of stock pictograms.
  {%- endcomment -%}
  {%- when 'thigh-smooth' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.6 2.6C7.2 5 5.9 7.9 5.9 11.1c0 3.3 1.1 6.4 3.2 9.3"/><path d="M15.7 2.6c1 1.7 1.6 3.5 1.8 5.3"/><circle cx="10.5" cy="9" r=".85"/><circle cx="13.1" cy="11.5" r=".85"/><circle cx="10.8" cy="14" r=".85"/><path d="m16.7 12.6.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8Z"/></svg>
  {%- when 'leg-tone' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.9 2.6c-1.8 2.9-2.7 5.6-2.7 8 0 2.8 1.1 5.8 3.3 9.2"/><path d="M8.7 4.8c-1.3 2.6-2 5-2 7.1 0 2.4.8 5 2.4 7.9"/><path d="m5 8.2.6 1.5 1.5.6-1.5.6-.6 1.5-.6-1.5-1.5-.6 1.5-.6.6-1.5Z"/><path d="m17.8 12.4.7 1.7 1.7.7-1.7.7-.7 1.7-.7-1.7-1.7-.7 1.7-.7.7-1.7Z"/></svg>
  {%- when 'bum-lift' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.2 7.4h9.6"/><path d="M7.2 7.4c-1.2 2.1-1.6 4.2-1 5.9.7 2.1 2.9 3 4.6 1.8 1-.8 1.4-2.3 1.2-4.1"/><path d="M16.8 7.4c1.2 2.1 1.6 4.2 1 5.9-.7 2.1-2.9 3-4.6 1.8-1-.8-1.4-2.3-1.2-4.1"/><path d="M3.4 18.4v-4.2m-1.3 1.3 1.3-1.3 1.3 1.3"/><path d="M20.6 18.4v-4.2m-1.3 1.3 1.3-1.3 1.3 1.3"/></svg>
  {%- when 'figure-slim' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.3 4.6h5.4"/><path d="M10.1 4.6c-.7 3.4-1 6.6-1 9.5 0 2.1.2 3.9.6 5.4"/><path d="M13.9 4.6c.7 3.4 1 6.6 1 9.5 0 2.1-.2 3.9-.6 5.4"/><path d="M2.6 12.2H6m-1.4-1.4L6 12.2l-1.4 1.4"/><path d="M21.4 12.2H18m1.4-1.4L18 12.2l1.4 1.4"/></svg>
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
  {%- when 'arrows' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 7-4 5 4 5M15 7l4 5-4 5"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1 12.5H7L6 8Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
  {%- when 'chevron' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'arrow-right' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
  {%- when 'calendar-clock' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 5.5A1.5 1.5 0 0 0 14.5 4H4A1.5 1.5 0 0 0 2.5 5.5V15.5A1.5 1.5 0 0 0 4 17H10"/><path d="M16 5.5V10"/><path d="M2.5 8H14.5"/><path d="M6.5 2.5V5.5M11.5 2.5V5.5"/><path d="M6 11h1.5M10 11h1.5M6 14h1.5" opacity=".45"/><circle cx="16.5" cy="16.5" r="5"/><path d="M16.5 14.2V16.5H18.4"/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6.75V12l3.4 2"/></svg>
  {%- when 'flame' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true"><path d="M12 2c.6 3.1-1.3 4.6-2.7 6C7.7 9.5 6 11.2 6 14a6 6 0 0 0 12 0c0-2.3-1-3.9-2-5.2-.3 1-.9 1.8-1.8 2.1.4-2.1-.3-4.2-2.2-6C12 4.6 12 3.3 12 2z"/></svg>
{%- endcase -%}
